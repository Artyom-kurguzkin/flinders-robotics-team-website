---
interface Props {
	title: string;
	eyebrow?: string;
	lead?: string;
}

const { title, eyebrow, lead } = Astro.props;
---

<section class="header">
	<div class="header__inner">
		{eyebrow && <p class="label-large header__eyebrow">{eyebrow}</p>}
		<h1>{title}</h1>
		{lead && <p class="header__lead">{lead}</p>}
	</div>
</section>

<style>
	.header {
		background: var(--md-sys-color-surface-container);
		color: var(--md-sys-color-on-surface);
		border-bottom: 1px solid var(--md-sys-color-outline-variant);
	}

	.header__inner {
		max-width: var(--content-width);
		margin-inline: auto;
		padding: clamp(2rem, 6vw, 3.5rem) 1.5rem;
	}

	.header__eyebrow {
		margin: 0 0 0.5rem;
		text-transform: uppercase;
		letter-spacing: 0.08em;
		color: var(--md-sys-color-primary);
	}

	.header h1 {
		margin: 0;
	}

	.header__lead {
		margin: 0.75rem 0 0;
		max-width: 52ch;
		font-size: 1.0625rem;
		line-height: 1.6;
		color: var(--md-sys-color-on-surface-variant);
	}
</style>
