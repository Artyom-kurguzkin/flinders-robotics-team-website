---
interface Props {
	title: string;
}

const { title } = Astro.props;
---

<section class="header">
	<div class="header__inner">
		<h1>{title}</h1>
	</div>
</section>

<style>
	.header {
		position: relative;
		isolation: isolate;
		color: var(--md-sys-color-on-surface);
	}

	/* A flat, hard-edged gold block and nothing else. No decorative artwork: the
	   guideline's curve device is built for poster-shaped space, and in a band this
	   short it can only read as a corner sticker or a cropped fragment. Flinders'
	   own site carries no artwork in its page headers either — the title does the
	   work. Same treatment as the tab strips. */
	.header::before {
		content: '';
		position: absolute;
		/* Run the gold up behind the floating pill header, so there is no white strip
		   above, beside or below it. The pill stays white and sits on top: the app bar
		   is z-index 10, this is -1 inside .header. */
		inset: calc(-1 * (var(--app-bar-height) + 0.75rem)) 0 0;
		z-index: -1;
		pointer-events: none;
		background: var(--brand-yellow);
	}

	.header__inner {
		max-width: var(--content-width);
		margin-inline: auto;
		padding: clamp(0.9rem, 1.6vw, 1.25rem) 1.5rem;
	}

	/* A title band, not a hero — it repeats on every page, so it stays tight rather
	   than growing with the viewport the way the shared h1 scale does. */
	.header h1 {
		margin: 0;
		max-width: 18ch;
		font-size: clamp(1.6rem, 1.3rem + 0.9vw, 2rem);
	}

</style>
