---
interface Props {
	title: string;
}

const { title } = Astro.props;
---

<section class="header">
	<div class="header__inner">
		<h1>{title}</h1>
	</div>
</section>

<style>
	.header {
		position: relative;
		isolation: isolate;
		color: var(--md-sys-color-on-surface);
	}

	/* Same treatment as the tab strips: a yellow base that fades into the page at the top and
	   bottom, with the hand-drawn halftone artwork fading into that yellow from the right. */
	.header::before,
	.header::after {
		content: '';
		position: absolute;
		inset: 0;
		z-index: -1;
		pointer-events: none;
	}

	.header::before {
		background: var(--brand-yellow);
		-webkit-mask-image: linear-gradient(to bottom, transparent, #000 30%, #000 70%, transparent);
		mask-image: linear-gradient(to bottom, transparent, #000 30%, #000 70%, transparent);
	}

	.header::after {
		background: url('../assets/patterns/riso-band.svg') right center / cover no-repeat;
		-webkit-mask-image: linear-gradient(90deg, transparent 30%, #000 72%),
			linear-gradient(to bottom, transparent, #000 30%, #000 70%, transparent);
		mask-image: linear-gradient(90deg, transparent 30%, #000 72%),
			linear-gradient(to bottom, transparent, #000 30%, #000 70%, transparent);
		-webkit-mask-composite: source-in;
		mask-composite: intersect;
	}

	.header__inner {
		max-width: var(--content-width);
		margin-inline: auto;
		padding: clamp(1.5rem, 3vw, 2.25rem) 1.5rem;
	}


	.header h1 {
		margin: 0;
		max-width: 18ch;
	}

</style>
