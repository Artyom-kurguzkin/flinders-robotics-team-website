---
import { Image } from 'astro:assets';
import flindersLogo from '../assets/Flinders-Logo-white.png';

const base = import.meta.env.BASE_URL;
const href = (path: string) => `${base}${path}`.replace(/\/{2,}/g, '/');

const links = [
	['About Us', 'about/'],
	['Technical Specifications', 'technical-specifications/'],
	['Research', 'research/'],
	['Competitions', 'competitions/'],
	['Contact', 'contact/'],
];
---

<footer class="footer">
	<div class="footer__inner">
		<img
			class="footer__mark"
			src={href('brand/frt-mark-white.svg')}
			alt="Flinders Robotics Team"
			width="40"
			height="40"
		/>

		<nav class="footer__nav" aria-label="Footer">
			{links.map(([label, path]) => <a href={href(path)}>{label}</a>)}
		</nav>

		<a class="footer__flinders" href="https://www.flinders.edu.au/" target="_blank" rel="noopener noreferrer">
			<Image src={flindersLogo} alt="Flinders University" width={240} loading="lazy" />
		</a>

		<p class="footer__uni body-medium">
			<span>South Australia | Northern Territory</span>
			<span>Global | Online</span>
			<span>CRICOS Provider: 00114A</span>
		</p>
	</div>
</footer>

<style>
	.footer {
		background: var(--brand-navy);
		color: rgb(255 255 255 / 0.78);
	}

	.footer__inner {
		max-width: var(--content-width);
		margin-inline: auto;
		padding: 1rem 1.5rem;
		display: grid;
		gap: 0.6rem 2rem;
		align-items: center;
		grid-template-columns: 1fr;
	}

	@media (min-width: 48rem) {
		.footer__inner {
			grid-template-columns: auto 1fr auto;
			grid-template-areas:
				'logo nav flinders'
				'logo uni flinders';
		}

		.footer__flinders {
			grid-area: flinders;
			justify-self: end;
		}

		.footer__mark {
			grid-area: logo;
		}

		.footer__nav {
			grid-area: nav;
		}

		.footer__uni {
			grid-area: uni;
		}
	}

	.footer__mark {
		width: 2.5rem;
		height: 2.5rem;
	}

	/* the Flinders logo's white version, as used on the original site's footer */
	.footer__flinders {
		display: block;
		line-height: 0;
	}

	.footer__flinders :global(img) {
		display: block;
		height: 2.5rem;
		width: auto;
	}

	.footer__nav {
		display: flex;
		flex-wrap: wrap;
		gap: 0.4rem 1.5rem;
	}

	.footer__nav a {
		color: #fff;
		font-size: 0.875rem;
		font-weight: 500;
		text-decoration: none;
	}

	.footer__nav a:hover {
		color: var(--brand-yellow);
		text-decoration: underline;
	}

	.footer__uni {
		margin: 0;
		font-size: 0.8125rem;
		display: flex;
		flex-wrap: wrap;
		gap: 0.15rem 1.25rem;
	}
</style>
