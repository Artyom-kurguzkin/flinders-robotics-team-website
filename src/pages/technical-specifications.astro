---
import { Image } from 'astro:assets';
import Layout from '../layouts/Layout.astro';
import PageHeader from '../components/PageHeader.astro';
import tasks from '../data/tasks.json';
import { Content as CommsContent } from '../data/system-communication.md';
import { Content as SafetyContent } from '../data/safety-features.md';
import overviewDiagram from '../assets/TechnicalStructure1RobotX.png';

// Task diagrams are named in tasks.json, so resolve them by glob.
const diagrams = import.meta.glob<{ default: ImageMetadata }>(
	'../assets/TechnicalStructure*.png',
	{ eager: true }
);
const diagramFor = (file: string) => diagrams[`../assets/${file}`]?.default;

const panels = ['Task Breakdown', 'System Communication and Integration', 'Safety Features'];
---

<Layout title="Technical Specifications">
	<PageHeader title="Technical Information" />

	<div class="page">
		<section class="section prose intro">
			<p>
				To complete the tasks outlined in the competition, our team came up with these algorithms as
				a baseline to find solutions.
			</p>
			<p>General functions required for the tasks:</p>
			<ol>
				<li>
					Identifying a shape, colour, and position of buoys
					<ol type="a">
						<li>Use of lidar to recognize the shape and position of buoys</li>
						<li>Use of LiveCams to recognize the colour of the buoys</li>
						<li>Calibration of the lidar and cameras to overlay feed in the control system</li>
					</ol>
				</li>
			</ol>

			<figure class="figure">
				<Image src={overviewDiagram} alt="" width={931} loading="lazy" />
				<figcaption class="body-medium">image courtesy of Andrew Lammas</figcaption>
			</figure>
		</section>

		<div class="tabbar">
			<md-tabs aria-label="Technical section">
				{
					panels.map((label, i) => (
						<md-primary-tab
							id={`tab-${i}`}
							aria-controls={`panel-${i}`}
							active={i === 0 ? true : undefined}
						>
							{label}
						</md-primary-tab>
					))
				}
			</md-tabs>
		</div>

		<section id="panel-0" role="tabpanel" aria-labelledby="tab-0" class="panel tasks">
			{
				tasks.map((task) => (
					<article class="task">
						<h2>{task.heading}</h2>
						{task.intro && <p>{task.intro}</p>}
						<ol>
							{task.steps.map((step) =>
								typeof step === 'string' ? (
									<li>{step}</li>
								) : (
									<li>
										{step.text}
										<ol type="a">
											{step.sub.map((sub) => (
												<li>{sub}</li>
											))}
										</ol>
									</li>
								)
							)}
						</ol>
						{task.figure && diagramFor(task.figure) && (
							<figure class="figure">
								<Image src={diagramFor(task.figure)!} alt="" width={900} loading="lazy" />
								<figcaption class="body-medium">{task.caption}</figcaption>
							</figure>
						)}
					</article>
				))
			}
		</section>

		<section id="panel-1" role="tabpanel" aria-labelledby="tab-1" class="panel prose-wide">
			<CommsContent />
		</section>

		<section id="panel-2" role="tabpanel" aria-labelledby="tab-2" class="panel prose-wide">
			<SafetyContent />
		</section>
	</div>
</Layout>

<script>
	import '@material/web/tabs/tabs.js';
	import '@material/web/tabs/primary-tab.js';

	// Panels render visible by default, so the page reads fully without JS.
	const tabs = document.querySelector('md-tabs');
	const panels = [...document.querySelectorAll<HTMLElement>('[role="tabpanel"]')];

	function show(index: number) {
		panels.forEach((panel, i) => (panel.hidden = i !== index));
	}

	if (tabs && panels.length) {
		show(0);
		tabs.addEventListener('change', () => {
			show((tabs as HTMLElement & { activeTabIndex: number }).activeTabIndex);
		});
	}
</script>

<style>
	.intro :global(ol) {
		padding-left: 1.4rem;
	}

	.intro :global(li),
	.task li {
		line-height: 1.6;
		color: var(--md-sys-color-on-surface-variant);
	}

	.figure {
		margin: 1.25rem 0 0;
		max-width: 48rem;
	}

	.figure :global(img) {
		width: 100%;
		height: auto;
		border-radius: var(--md-sys-shape-corner-medium);
		background: #fff;
		padding: 0.5rem;
	}

	/* Reckless Neue Medium Italic — the brand's sub-heading/caption pairing (p.52) */
	.figure figcaption {
		margin-top: 0.4rem;
		color: var(--md-sys-color-on-surface-variant);
		font-family: var(--brand-typeface-accent);
		font-style: italic;
		font-weight: 500;
	}

	.tasks {
		max-width: 60rem;
	}

	.task {
		margin-bottom: 2.5rem;
	}

	.task h2 {
		font-size: 1.375rem;
	}

	.task ol {
		padding-left: 1.4rem;
		margin: 0.5rem 0 0;
	}

	.task li {
		margin-bottom: 0.4rem;
	}

	.task p {
		color: var(--md-sys-color-on-surface-variant);
		line-height: 1.6;
	}

	/* Markdown-rendered panels */
	.prose-wide {
		max-width: 52rem;
	}

	.prose-wide :global(h2) {
		margin-top: 2rem;
	}

	.prose-wide :global(h2:first-child) {
		margin-top: 0;
	}

	.prose-wide :global(p),
	.prose-wide :global(li) {
		line-height: 1.65;
		color: var(--md-sys-color-on-surface-variant);
	}

	.prose-wide :global(ul) {
		padding-left: 1.2rem;
	}

	.prose-wide :global(li) {
		margin-bottom: 0.4rem;
	}

	.prose-wide :global(img) {
		width: 100%;
		max-width: 40rem;
		height: auto;
		border-radius: var(--md-sys-shape-corner-medium);
		background: #fff;
		padding: 0.5rem;
		margin-top: 1rem;
	}

	/* An italic line that follows an image acts as its caption. Scoped to
	   paragraphs containing an image, so ordinary inline italics (linkloss, stop,
	   manual, auto) stay inline. */
	.prose-wide :global(p:has(> img) > em) {
		display: block;
		margin-top: 0.4rem;
		font-size: 0.875rem;
	}
</style>
