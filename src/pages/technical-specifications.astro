---
import { Image } from 'astro:assets';
import Layout from '../layouts/Layout.astro';
import PageHeader from '../components/PageHeader.astro';
import tasks from '../data/tasks.json';
import { Content as SafetyContent } from '../data/safety-and-comms.md';
import estop from '../assets/RobotXEstop.png';
import shrouds from '../assets/RobotXPropellorShroud1and2.png';

// The eight structure diagrams are unlabelled on the source site, so they are
// presented as a numbered set rather than captioned with guesses.
const diagrams = Object.values(
	import.meta.glob<{ default: ImageMetadata }>('../assets/TechnicalStructure*.png', {
		eager: true,
	})
).map((mod) => mod.default);
---

<Layout
	title="Technical Specifications"
	description="The competition task list, TopCat's communication architecture, and its safety systems."
>
	<PageHeader
		title="Technical Specifications"
		eyebrow="TopCat"
		lead="Baseline algorithms were developed for each competition task — identifying buoys by shape and position with lidar, and by colour with the cameras."
	/>

	<div class="page">
		<section class="section">
			<h2>Task breakdown</h2>
			<p class="prose body-large">
				The competition is scored as a set of discrete tasks. Each one is expanded below.
			</p>

			<div class="tasks">
				{
					tasks.map((task) => (
						<details class="task">
							<summary class="task__summary state-layer">
								<span class="task__number">{task.number}</span>
								<md-icon class="task__icon">{task.icon}</md-icon>
								<span class="task__title">{task.title}</span>
								<md-icon class="task__chevron" aria-hidden="true">
									expand_more
								</md-icon>
							</summary>
							<p class="task__detail body-medium">{task.detail}</p>
						</details>
					))
				}
			</div>
		</section>

		<section class="section prose systems">
			<SafetyContent />
		</section>

		<section class="section">
			<h2>Safety hardware</h2>
			<div class="figures">
				<figure class="md-card md-card--outlined">
					<Image src={shrouds} alt="Propeller shrouds fabricated at Flinders University" width={700} height={450} loading="lazy" />
					<figcaption class="body-medium">
						Propeller shrouds, rolled and assembled in-house.
					</figcaption>
				</figure>
				<figure class="md-card md-card--outlined">
					<Image src={estop} alt="IP67-rated emergency stop installed on the vessel" width={700} height={450} loading="lazy" />
					<figcaption class="body-medium">
						One of four IP67 emergency stops on its acetal faceplate.
					</figcaption>
				</figure>
			</div>
		</section>

		<section class="section">
			<h2>System diagrams</h2>
			<div class="figures figures--diagrams">
				{
					diagrams.map((diagram, i) => (
						<figure class="md-card md-card--outlined diagram">
							<Image src={diagram} alt={`TopCat system diagram ${i + 1}`} width={900} loading="lazy" />
							<figcaption class="body-medium">Diagram {i + 1}</figcaption>
						</figure>
					))
				}
			</div>
		</section>
	</div>
</Layout>

<script>
	import '@material/web/icon/icon.js';
</script>

<style>
	/* ponytail: native <details> — free keyboard handling and open/close state.
	   Styled to read as an M3 expandable list item. */
	.tasks {
		display: grid;
		gap: 0.5rem;
		margin-top: 1.5rem;
	}

	.task {
		background: var(--md-sys-color-surface-container-low);
		border-radius: var(--md-sys-shape-corner-medium);
		overflow: hidden;
	}

	.task__summary {
		display: flex;
		align-items: center;
		gap: 1rem;
		padding: 1rem 1.25rem;
		cursor: pointer;
		list-style: none;
		font-weight: 500;
	}

	.task__summary::-webkit-details-marker {
		display: none;
	}

	.task__number {
		flex: none;
		width: 1.75rem;
		height: 1.75rem;
		display: grid;
		place-items: center;
		border-radius: 50%;
		background: var(--md-sys-color-primary);
		color: var(--md-sys-color-on-primary);
		font-size: 0.8125rem;
	}

	.task__icon {
		flex: none;
		color: var(--md-sys-color-primary);
	}

	.task__title {
		flex: 1 1 auto;
		min-width: 0;
	}

	.task__chevron {
		flex: none;
		color: var(--md-sys-color-on-surface-variant);
	}

	.task[open] .task__chevron {
		transform: rotate(180deg);
	}

	@media (prefers-reduced-motion: no-preference) {
		.task__chevron {
			transition: transform var(--md-sys-motion-duration-short)
				var(--md-sys-motion-easing-standard);
		}
	}

	.task__detail {
		margin: 0;
		padding: 0 1.25rem 1.25rem calc(1.25rem + 1.75rem + 1rem);
		color: var(--md-sys-color-on-surface-variant);
		max-width: 70ch;
	}

	.systems :global(h2) {
		margin-top: 2.5rem;
		color: var(--md-sys-color-primary);
	}

	.figures {
		display: grid;
		gap: 1rem;
		grid-template-columns: repeat(auto-fill, minmax(18rem, 1fr));
	}

	.figures figure {
		margin: 0;
		padding: 1rem;
	}

	.figures :global(img) {
		width: 100%;
		height: auto;
		border-radius: var(--md-sys-shape-corner-small);
		background: #fff;
	}

	.figures figcaption {
		margin-top: 0.75rem;
		color: var(--md-sys-color-on-surface-variant);
	}

	/* Diagrams carry fine detail and thin lines — give them more width each. */
	.figures--diagrams {
		grid-template-columns: repeat(auto-fill, minmax(24rem, 1fr));
	}

	.diagram :global(img) {
		object-fit: contain;
	}
</style>
