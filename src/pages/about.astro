---
import { Image } from 'astro:assets';
import Layout from '../layouts/Layout.astro';
import PageHeader from '../components/PageHeader.astro';
import { Content as AboutContent } from '../data/about.md';
import { Content as VesselContent } from '../data/vessel.md';
import team from '../data/team.json';
import vesselGrid from '../data/vessel-grid.json';
import timeline from '../data/timeline.json';
import sponsors from '../data/sponsors.json';
import linkedinIcon from '../assets/linkedin.png';

// Images are named in the JSON files, so resolve them by glob rather than one
// static import each.
const assets = import.meta.glob<{ default: ImageMetadata }>('../assets/**/*.{jpg,jpeg,png}', {
	eager: true,
});
const img = (file: string) => assets[`../assets/${file}`]?.default;

const tiers = [...new Set(sponsors.map((s) => s.tier))];

// A new member can be listed before their photo and details arrive; the card
// falls back to their initials and drops the rows it has nothing for.
const initials = (name: string) =>
	name
		.split(/\s+/)
		.map((word) => word[0])
		.join('')
		.slice(0, 2)
		.toUpperCase();
const panels = ['Meet the Team', 'The Vessel', 'Development Process', 'Sponsors'];
---

<Layout title="About Us">
	<PageHeader title="About Us" />

	<div class="page">
		<section class="section intro">
			<div class="prose">
				<AboutContent />
			</div>

			<div class="video">
				<iframe
					src="https://www.youtube-nocookie.com/embed/iNDHslCrS4c"
					title="Flinders University Meet the Team"
					allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share"
					referrerpolicy="strict-origin-when-cross-origin"
					allowfullscreen
				></iframe>
			</div>
		</section>

		<div class="tabbar">
			<md-tabs aria-label="About section">
				{
					panels.map((label, i) => (
						<md-primary-tab
							id={`tab-${i}`}
							aria-controls={`panel-${i}`}
							active={i === 0 ? true : undefined}
						>
							{label}
						</md-primary-tab>
					))
				}
			</md-tabs>
		</div>

		<!-- Meet the Team -->
		<section id="panel-0" role="tabpanel" aria-labelledby="tab-0" class="panel">
			<h2>Meet the Team</h2>
			<p class="body-large">Team Name: Team Australis<sup>2</sup></p>
			<p class="body-large">
				Team Contact: <a href="mailto:FlindersRoboticsTeam@gmail.com">FlindersRoboticsTeam@gmail.com</a>
			</p>

			<div class="people">
				{
					team.map((member) => (
						<article class="person">
							{img(`team/${member.photo}`) ? (
								<Image
									class="person__photo"
									src={img(`team/${member.photo}`)!}
									alt={member.name}
									width={240}
									height={240}
									loading="lazy"
								/>
							) : (
								<span class="person__photo person__photo--initials" aria-hidden="true">
									{initials(member.name)}
								</span>
							)}
							<h3 class="person__name">{member.name}</h3>
							{member.role && <p class="person__role">{member.role}</p>}
							{member.qualifications && <p class="person__qual">{member.qualifications}</p>}
							{(member.email || member.linkedin) && (
							<p class="person__contact">
								{member.email && <a href={`mailto:${member.email}`}>{member.email}</a>}
								{member.linkedin && (
									<a
										class="linkedin"
										href={member.linkedin}
										target="_blank"
										rel="noopener noreferrer"
										aria-label={`${member.name} on LinkedIn`}
									>
										<Image src={linkedinIcon} alt="" width={22} height={22} loading="lazy" />
									</a>
								)}
							</p>
							)}
						</article>
					))
				}
			</div>
		</section>

		<!-- The Vessel -->
		<section id="panel-1" role="tabpanel" aria-labelledby="tab-1" class="panel">
			<div class="prose vessel-prose">
				<VesselContent />
			</div>

			<div class="tiles">
				{
					vesselGrid.map((tile) => (
						<article class="tile">
							<Image
								class="tile__photo"
								src={img(tile.image)!}
								alt={tile.title}
								width={480}
								height={360}
								loading="lazy"
							/>
							<div class="tile__body">
								<h3>{tile.title}</h3>
								{tile.lines.map((line) => (
									<p>{line}</p>
								))}
							</div>
						</article>
					))
				}
			</div>
		</section>

		<!-- Development Process -->
		<section id="panel-2" role="tabpanel" aria-labelledby="tab-2" class="panel">
			<div class="prose">
				<h2>Where we started</h2>
				<p>
					In 2012 the Maritime RobotX Challenge was launched by the{' '}
					<a href="http://www.onr.navy.mil/" target="_blank" rel="noopener noreferrer">US Office of Naval Research.</a>{' '}
					A joint Flinders University and Centre for Defence Engineering Research and Training (<a href="https://www.flinders.edu.au/cdert" target="_blank" rel="noopener noreferrer">CDERT</a>) was successful in applying to be part of the inaugural event and herein was born Topcat.
				</p>
				<h3>Hardware Design</h3>
				<p>
					Developing Topcat has been a very iterative process. The initial vessel design focussed on
					solving the 2014 RobotX challenge tasks including navigation, obstacle avoidance and
					docking. This was a great base but new and ongoing research tasks and challenges have
					necessitated continual upgrades for Topcat.
				</p>
			</div>

			<hr />

			<h2>Development Timeline</h2>
			<ol class="timeline">
				{
					timeline.map((entry) => (
						<li class="timeline__item">
							<div class="timeline__marker" aria-hidden="true" />
							<div class="timeline__body">
								<span class="timeline__period label-large">{entry.period}</span>
								<h3>{entry.title}</h3>
								{img(entry.photo) && (
									<figure class="timeline__figure">
										<Image
											src={img(entry.photo)!}
											alt=""
											width={640}
											height={360}
											loading="lazy"
										/>
										{entry.caption && <figcaption class="body-medium">{entry.caption}</figcaption>}
									</figure>
								)}
								<p set:html={entry.html} />
							</div>
						</li>
					))
				}
			</ol>
		</section>

		<!-- Sponsors -->
		<section id="panel-3" role="tabpanel" aria-labelledby="tab-3" class="panel">
			<h2>Sponsors</h2>
			<p class="body-large prose">
				We gratefully appreciate all of our sponsors for their time and commitment to the project.
				A special thank you to the following sponsors for their contribution to the project.
			</p>

			{
				tiers.map((tier) => (
					<div class="tier">
						<h3 class="tier__title">{tier}</h3>
						<div class="sponsors">
							{sponsors
								.filter((s) => s.tier === tier)
								.map((sponsor) => (
									<article class="sponsor">
										<div class="sponsor__body">
											<h4 class="sponsor__name">{sponsor.name}</h4>
											<p class="sponsor__text">{sponsor.text}</p>
											<p>
												To find out more please visit:{' '}
												<a href={sponsor.url} target="_blank" rel="noopener noreferrer">
													{sponsor.linkText}
												</a>
											</p>
										</div>
										<a
											class="sponsor__logo"
											href={sponsor.url}
											target="_blank"
											rel="noopener noreferrer"
											aria-label={sponsor.name}
										>
											<Image src={img(sponsor.logo)!} alt="" width={420} loading="lazy" />
										</a>
									</article>
								))}
						</div>
					</div>
				))
			}
		</section>
	</div>
</Layout>

<script>
	import '@material/web/tabs/tabs.js';
	import '@material/web/tabs/primary-tab.js';

	const tabs = document.querySelector('md-tabs');
	const panels = [...document.querySelectorAll<HTMLElement>('[role="tabpanel"]')];

	function show(index: number) {
		panels.forEach((panel, i) => (panel.hidden = i !== index));
	}

	if (tabs && panels.length) {
		// A link ending in #panel-N opens that tab (the home page's "The Vessel"
		// tile points at #panel-1).
		const start = Math.max(
			panels.findIndex((panel) => `#${panel.id}` === location.hash),
			0
		);
		show(start);
		if (start) {
			(tabs as HTMLElement & { activeTabIndex: number }).activeTabIndex = start;
			// after a frame: the browser's own jump to #panel-N lands last, and
			// un-hiding the panel has moved everything below it anyway
			requestAnimationFrame(() => document.querySelector('.tabbar')?.scrollIntoView());
		}
		tabs.addEventListener('change', () => {
			show((tabs as HTMLElement & { activeTabIndex: number }).activeTabIndex);
		});
	}
</script>

<style>
	.intro {
		display: grid;
		gap: 2rem;
		align-items: start;
		grid-template-columns: 1fr;
	}

	@media (min-width: 52rem) {
		.intro {
			grid-template-columns: 1fr 1fr;
		}
	}

	.video {
		position: relative;
		aspect-ratio: 16 / 9;
		border-radius: var(--md-sys-shape-corner-large);
		overflow: hidden;
		box-shadow: var(--md-sys-elevation-2);
		background: var(--brand-navy);
	}

	.video iframe {
		position: absolute;
		inset: 0;
		width: 100%;
		height: 100%;
		border: 0;
	}

	/* === Photo tiles: people === */
	.people {
		display: grid;
		gap: 1.25rem;
		margin-top: 1.5rem;
		grid-template-columns: repeat(auto-fit, minmax(19rem, 1fr));
	}

	.person {
		display: flex;
		flex-direction: column;
		align-items: center;
		text-align: center;
		padding: 1.75rem 1.25rem 1.5rem;
		/* blue bar along the top edge; a gradient follows the rounded corners */
		background: linear-gradient(var(--brand-navy), var(--brand-navy)) top / 100% 0.4rem no-repeat,
			var(--md-sys-color-surface-container-lowest);
		border-radius: var(--md-sys-shape-corner-large);
		box-shadow: var(--md-sys-elevation-1);
	}

	.person__photo {
		width: 6.5rem;
		height: 6.5rem;
		border-radius: 50%;
		object-fit: cover;
		object-position: center 20%;
		box-shadow: 0 0 0 0.2rem #fff, 0 0 0 0.4rem var(--brand-navy);
		margin-bottom: 1.1rem;
	}

	/* stand-in until a photo arrives */
	.person__photo--initials {
		display: grid;
		place-items: center;
		background: var(--brand-sky);
		color: var(--brand-navy);
		font-size: 2rem;
		font-weight: 800;
		letter-spacing: 0.02em;
	}

	.person__name {
		margin: 0;
		font-size: 1.125rem;
	}

	.person__role {
		margin: 0.25rem 0 0;
		font-weight: 600;
		color: var(--md-sys-color-on-surface);
	}

	.person__qual {
		margin: 0.4rem 0 0.85rem;
		font-size: 0.875rem;
		line-height: 1.45;
		color: var(--md-sys-color-on-surface-variant);
	}

	/* === Card contact line === */
	.person__contact {
		margin: auto 0 0;
		padding-top: 0.85rem;
		width: 100%;
		border-top: 1px solid var(--md-sys-color-outline-variant);
		font-size: 0.875rem;
		line-height: 1.5;
		overflow-wrap: anywhere;
	}

	.linkedin {
		display: inline-block;
		vertical-align: middle;
		margin-left: 0.4rem;
	}

	.linkedin :global(img) {
		width: 1.375rem;
		height: 1.375rem;
	}

	/* === Vessel === */
	.vessel-prose :global(h2) {
		margin-top: 2rem;
	}

	.vessel-prose :global(h2:first-child) {
		margin-top: 0;
	}

	/* Full-width column, with the reading width kept on the text itself; the photo
	   floats right on a wide screen so the right half is not left empty. */
	.vessel-prose {
		max-width: none;
	}

	.vessel-prose :global(p),
	.vessel-prose :global(h2) {
		max-width: 46rem;
	}

	/* the paragraph markdown wraps around an image must not carry that limit, or the
	   float lands at the edge of a narrow box instead of the panel's right edge */
	.vessel-prose :global(p:has(> img)) {
		max-width: none;
	}

	.vessel-prose :global(img) {
		width: 100%;
		max-width: 32rem;
		height: auto;
		border-radius: var(--md-sys-shape-corner-large);
		margin-block: 1rem;
	}

	@media (min-width: 64rem) {
		.vessel-prose :global(img) {
			float: right;
			width: min(38%, 28rem);
			margin: 0 0 1.5rem 2.5rem;
		}
	}

	.vessel-prose :global(hr) {
		border: none;
		border-top: 1px solid var(--md-sys-color-outline-variant);
		margin-block: 2rem;
	}

	.tiles {
		display: grid;
		gap: 1.25rem;
		margin-top: 2rem;
		grid-template-columns: repeat(auto-fit, minmax(17rem, 1fr));
	}

	.tile {
		display: flex;
		flex-direction: column;
		background: var(--md-sys-color-surface-container-lowest);
		border-radius: var(--md-sys-shape-corner-large);
		box-shadow: var(--md-sys-elevation-1);
		overflow: hidden;
	}

	.tile__photo {
		width: 100%;
		height: auto;
		aspect-ratio: 4 / 3;
		object-fit: cover;
	}

	.tile__body {
		padding: 1.1rem 1.25rem 1.4rem;
		border-top: 0.4rem solid var(--brand-deep-gold);
	}

	.tile:nth-child(3n + 2) .tile__body {
		border-top-color: var(--brand-yellow);
	}

	.tile:nth-child(3n) .tile__body {
		border-top-color: var(--brand-orange);
	}

	.tile__body h3 {
		margin: 0 0 0.4rem;
	}

	.tile__body p {
		margin: 0 0 0.5rem;
		font-size: 0.9375rem;
		line-height: 1.55;
		color: var(--md-sys-color-on-surface-variant);
	}

	/* === Development process === */
	.panel hr {
		border: none;
		border-top: 1px solid var(--md-sys-color-outline-variant);
		margin-block: 2.5rem;
	}

	.timeline {
		list-style: none;
		padding: 0;
		margin: 1.5rem 0 0;
		max-width: 46rem;
	}

	.timeline__item {
		position: relative;
		display: grid;
		grid-template-columns: 1.5rem 1fr;
		gap: 1rem;
		padding-bottom: 2.5rem;
	}

	.timeline__item:not(:last-child) .timeline__marker::after {
		content: '';
		position: absolute;
		left: 50%;
		top: 1rem;
		bottom: -1.5rem;
		width: 2px;
		transform: translateX(-50%);
		background: var(--md-sys-color-outline-variant);
	}

	.timeline__marker {
		position: relative;
		width: 0.85rem;
		height: 0.85rem;
		margin-top: 0.35rem;
		margin-inline: auto;
		border-radius: 50%;
		background: var(--brand-yellow);
		box-shadow: 0 0 0 0.2rem var(--brand-butter);
	}

	.timeline__item:nth-child(3n + 2) .timeline__marker {
		background: var(--brand-orange);
		box-shadow: 0 0 0 0.2rem var(--brand-peach);
	}

	.timeline__item:nth-child(3n) .timeline__marker {
		background: var(--brand-deep-gold);
		box-shadow: 0 0 0 0.2rem var(--brand-gold-tint);
	}

	/* navy, not Deep Gold: gold on white is ~2:1 and unreadable at this size */
	.timeline__period {
		display: block;
		color: var(--brand-navy);
		font-weight: 700;
		margin-bottom: 0.15rem;
	}

	.timeline__body h3 {
		margin-bottom: 0.75rem;
	}

	.timeline__body p {
		margin: 0;
		line-height: 1.6;
		color: var(--md-sys-color-on-surface-variant);
		overflow-wrap: anywhere;
	}

	.timeline__figure {
		margin: 0 0 0.85rem;
	}

	.timeline__figure :global(img) {
		width: 100%;
		height: auto;
		aspect-ratio: 16 / 9;
		object-fit: cover;
		border-radius: var(--md-sys-shape-corner-medium);
	}

	/* Reckless Neue Medium Italic — the brand's sub-heading/caption pairing (p.52) */
	.timeline__figure figcaption {
		margin-top: 0.4rem;
		font-family: var(--brand-typeface-accent);
		font-style: italic;
		font-weight: 500;
		color: var(--md-sys-color-on-surface-variant);
	}

	/* === Sponsors === */
	.tier {
		margin-top: 2.5rem;
	}

	.tier__title {
		margin-bottom: 1rem;
		padding: 0.35rem 1rem;
		width: fit-content;
		border-radius: 999px;
		background: var(--brand-gold-tint);
	}

	.tier:nth-of-type(2) .tier__title {
		background: var(--brand-butter);
	}

	.tier:nth-of-type(3) .tier__title {
		background: var(--brand-peach);
	}

	.sponsors {
		display: grid;
		gap: 1.25rem;
	}

	.sponsor {
		display: grid;
		grid-template-columns: 1fr;
		gap: 1.5rem;
		align-items: center;
		background: var(--md-sys-color-surface-container-lowest);
		border-radius: var(--md-sys-shape-corner-large);
		box-shadow: var(--md-sys-elevation-1);
		padding: 1.75rem;
	}

	@media (min-width: 48rem) {
		.sponsor {
			grid-template-columns: 1fr 14rem;
			gap: 2.5rem;
		}
	}

	.sponsor__name {
		margin: 0 0 0.5rem;
		font-size: 1.25rem;
	}

	.sponsor__body p {
		margin: 0 0 0.6rem;
		line-height: 1.6;
		color: var(--md-sys-color-on-surface-variant);
		overflow-wrap: anywhere;
	}

	/* Supplied logo artwork assumes a light background and comes in mixed aspect
	   ratios, so box it. */
	.sponsor__logo {
		display: grid;
		place-items: center;
		background: #fff;
		border: 1px solid var(--md-sys-color-outline-variant);
		border-radius: var(--md-sys-shape-corner-medium);
		padding: 1.25rem;
		min-height: 7rem;
	}

	.sponsor__logo :global(img) {
		max-width: 100%;
		max-height: 4.5rem;
		width: auto;
		height: auto;
		object-fit: contain;
	}
</style>
