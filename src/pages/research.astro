---
import Layout from '../layouts/Layout.astro';
import PageHeader from '../components/PageHeader.astro';
import { Content as ResearchContent } from '../data/research.md';

const areas = [
	{
		title: 'Mission planning',
		icon: 'map',
		detail:
			'Deciding what the vessel should do next, and in what order, when the course is only partly known. New planning algorithms aim to keep TopCat productive when tasks appear out of sequence or conditions change mid-run.',
	},
	{
		title: 'Control systems',
		icon: 'tune',
		detail:
			'Holding a commanded course and position against wind, current and wave action. Work here centres on predictive control to improve robustness and reliability at the actuator level.',
	},
	{
		title: 'Object recognition and classification',
		icon: 'visibility',
		detail:
			'Turning lidar returns and camera frames into a usable picture of the course — separating buoys, markers, docks and obstacles from clutter, and assigning them the right identity.',
	},
];
---

<Layout title="Research" description="Maritime autonomy research at the Centre for Defence Engineering Research and Training, Flinders University.">
	<PageHeader
		title="Research"
		eyebrow="CDERT"
		lead="TopCat is a competition entry and a research platform. The two feed each other."
	/>

	<div class="page">
		<section class="section prose">
			<ResearchContent />
		</section>

		<section class="section">
			<h2>Research areas</h2>
			<div class="card-grid">
				{
					areas.map((area) => (
						<article class="md-card md-card--elevated area">
							<md-icon class="area__icon">{area.icon}</md-icon>
							<h3 class="title-large">{area.title}</h3>
							<p class="body-medium">{area.detail}</p>
						</article>
					))
				}
			</div>
		</section>
	</div>
</Layout>

<script>
	import '@material/web/icon/icon.js';
</script>

<style>
	.area__icon {
		color: var(--md-sys-color-primary);
		--md-icon-size: 32px;
		margin-bottom: 0.5rem;
	}

	.area h3 {
		margin-bottom: 0.35rem;
	}

	.area p {
		margin: 0;
		color: var(--md-sys-color-on-surface-variant);
	}
</style>
