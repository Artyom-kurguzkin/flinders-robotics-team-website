---
import { Image } from 'astro:assets';
import Layout from '../layouts/Layout.astro';
import PageHeader from '../components/PageHeader.astro';
import { Content as ResearchContent } from '../data/research.md';
import beached from '../assets/topcat_beached.jpg';
---

<Layout
	title="Research"
	description="Maritime autonomy research at the Centre for Defence Engineering Research and Training, Flinders University."
>
	<PageHeader title="Current Research" />

	<div class="page">
		<section class="section research">
			<div class="prose research__text">
				<ResearchContent />
			</div>

			<Image
				class="research__photo"
				src={beached}
				alt="TopCat beached at the water's edge"
				width={1200}
				loading="eager"
			/>
		</section>
	</div>
</Layout>

<style>
	/* Text and photo side by side on a wide screen; stacked (text first, as on the
	   original) below that. */
	.research {
		display: grid;
		gap: 2rem 3.5rem;
		align-items: start;
	}

	@media (min-width: 64rem) {
		.research {
			grid-template-columns: minmax(0, 1fr) minmax(0, 1.2fr);
		}
	}

	.research__text :global(h2) {
		margin-top: 0;
	}

	.research__text :global(p),
	.research__text :global(li) {
		font-size: 1.0625rem;
		line-height: 1.7;
	}

	.research__text :global(ul) {
		padding-left: 1.3rem;
	}

	.research__photo {
		width: 100%;
		height: auto;
		border-radius: var(--md-sys-shape-corner-large);
		box-shadow: 0.9rem 0.9rem 0 var(--brand-yellow);
	}

	.research__text :global(h2)::after {
		content: '';
	display: block;
	width: 3rem;
	height: 0.3rem;
	margin-top: 0.55rem;
	border-radius: 2px;
		background: var(--brand-orange);
	}
</style>
