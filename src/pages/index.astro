---
import { Image } from 'astro:assets';
import Layout from '../layouts/Layout.astro';
import { href } from '../href';
import { Content as HomeContent } from '../data/home.md';
import Gallery from '../components/Gallery.astro';
import beached from '../assets/topcat_beached.jpg';
import vessel from '../assets/conference.jpg';
import singapore from '../assets/singapore_course.jpg';
---

<Layout title="Home">
	<div class="shell">
		<!-- ============ Hero: bento of rounded tiles ============ -->
		<section class="hero" aria-label="Flinders Robotics Team">
			<div class="tile hero__head">
				<h1>
					<span class="h1__line">Flinders<span class="arrow" aria-hidden="true"></span></span>
					<span class="h1__line">Robotics Team</span>
				</h1>
				<p class="hero__lede">This project is called TopCat Autonomous Surface Vessel.</p>
			</div>

			<div class="tile hero__photo">
				<Image
					class="fill fill--vessel"
					src={beached}
					alt="TopCat beached at the water's edge"
					width={1800}
					loading="eager"
				/>
				<a class="badge riso-hover riso-hover--warm" href={href('about/')}>Meet the Team</a>
				<div class="hero__actions">
					<a class="pill pill--solid riso-hover riso-hover--warm" href={href('contact/')}>
						Contact
						<span class="pill__icon" aria-hidden="true">
							<svg viewBox="0 0 24 24"><path d="M4 6h16v12H4zM4 7l8 6 8-6" /></svg>
						</span>
					</a>
				</div>
			</div>

			<a class="tile tile--photo riso-hover hero__vessel" href={href('technical-specifications/')}>
				<Image class="fill" src={vessel} alt="" width={900} loading="eager" />
				<span class="label">The Vessel</span>
			</a>

			<a class="tile tile--photo riso-hover hero__comps" href={href('competitions/')}>
				<Image class="fill fill--nocredit" src={singapore} alt="" width={900} loading="eager" />
				<span class="label">Competitions</span>
			</a>
		</section>

		<!-- ============ Welcome ============ -->
		<section class="welcome-wrap">
			<div class="tile welcome">
				<div class="welcome__flow">
					<h2 class="display">Welcome</h2>
					<div class="welcome__body">
						<HomeContent />
					</div>
				</div>
			</div>
		</section>

		<Gallery />
	</div>
</Layout>

<style>
	.shell {
		max-width: var(--shell-width);
		margin-inline: auto;
		padding: 0 0.75rem 2.5rem;
	}

	/* ---------- tile language ---------- */
	.tile {
		position: relative;
		overflow: hidden;
		border-radius: 1.75rem;
		background: var(--brand-sky);
		isolation: isolate;
	}

	.fill {
		position: absolute;
		inset: 0;
		width: 100%;
		height: 100%;
		object-fit: cover;
		z-index: -2;
		transition: transform 0.7s cubic-bezier(0.2, 0.7, 0.2, 1);
	}

	/* frame the beached vessel a little right of centre so both pontoons read */
	.fill--vessel {
		object-position: 58% 50%;
	}

	/* This source photo has a credit strip baked into its bottom edge. Let the image
	   run past the tile (anchored at the top) so that edge is clipped. */
	.fill--nocredit {
		height: 118%;
		object-position: 25% top;
	}

	/* bottom-up shade so white labels stay legible on any photo */
	.tile--photo::after {
		content: '';
		position: absolute;
		inset: 0;
		z-index: -1;
		background: linear-gradient(to top, rgb(13 27 53 / 0.82), rgb(13 27 53 / 0) 60%);
	}

	a.tile--photo:hover .fill {
		transform: scale(1.06);
	}

	.label {
		position: absolute;
		left: 1.25rem;
		bottom: 1.1rem;
		right: 1.25rem;
		color: #fff;
		font-weight: 800;
		font-size: clamp(1.15rem, 2vw, 1.85rem);
		letter-spacing: -0.02em;
		line-height: 1.1;
	}

	/* ---------- pills ---------- */
	.pill {
		display: inline-flex;
		align-items: center;
		gap: 1rem;
		height: 3.25rem;
		padding: 0 0.4rem 0 1.5rem;
		border-radius: 999px;
		font-size: 0.9375rem;
		font-weight: 600;
		text-decoration: none;
		white-space: nowrap;
		transition: transform 0.2s ease;
	}

	.pill:hover {
		transform: translateY(-2px);
	}

	.pill--solid {
		background: var(--brand-yellow);
		color: var(--brand-navy);
		border: 1px solid var(--md-sys-color-outline-variant);
	}

	.pill__icon {
		display: grid;
		place-items: center;
		width: 2.5rem;
		height: 2.5rem;
		border-radius: 50%;
		background: var(--brand-navy);
	}

	.pill--solid .pill__icon {
		background: var(--brand-blue);
	}

	.pill__icon svg {
		width: 1.15rem;
		height: 1.15rem;
		fill: none;
		stroke: #fff;
		stroke-width: 2;
		stroke-linecap: round;
		stroke-linejoin: round;
	}

		/* ---------- hero ---------- */
	.hero {
		display: grid;
		gap: 0.75rem;
		height: clamp(34rem, calc(100dvh - 5.75rem), 54rem);
		grid-template-columns: 1fr 1fr 2fr;
		grid-template-rows: 1.45fr 1fr;
		grid-template-areas:
			'head head photo'
			'vessel comps photo';
	}

	.hero__head {
		grid-area: head;
		background: var(--brand-yellow);
		display: flex;
		flex-direction: column;
		justify-content: space-between;
		padding: clamp(1.5rem, 3vw, 2.75rem);
	}

	.hero__head h1 {
		margin: 0;
		font-size: clamp(2.4rem, 5.3vw, 6.25rem);
		font-weight: 800;
		letter-spacing: -0.04em;
		line-height: 0.94;
		text-transform: uppercase;
		color: var(--brand-navy);
	}

	.h1__line {
		display: flex;
		align-items: center;
	}

	.arrow {
		position: relative;
		flex: 1;
		height: 0.2rem;
		min-width: 2rem;
		margin-inline: 0.9rem 0.25rem;
		background: currentColor;
		border-radius: 2px;
	}

	.arrow::after {
		content: '';
		position: absolute;
		right: 0;
		top: 50%;
		width: 0.85rem;
		height: 0.85rem;
		border-top: 0.2rem solid currentColor;
		border-right: 0.2rem solid currentColor;
		transform: translateY(-50%) rotate(45deg);
	}

	.hero__lede {
		margin: 0;
		max-width: 26ch;
		font-size: clamp(1rem, 1.25vw, 1.25rem);
		line-height: 1.45;
		color: var(--brand-navy);
	}

	.hero__photo {
		grid-area: photo;
		background: var(--brand-navy);
	}

	.hero__actions {
		position: absolute;
		right: 1.25rem;
		bottom: 1.25rem;
		display: flex;
		flex-wrap: wrap;
		justify-content: flex-end;
		gap: 0.6rem;
	}

	.badge {
		position: absolute;
		left: 1.5rem;
		top: 60%;
		display: grid;
		place-items: center;
		width: 10rem;
		height: 10rem;
		padding: 0.75rem;
		border-radius: 50%;
		text-align: center;
		text-decoration: none;
		font-size: 1.375rem;
		font-weight: 800;
		line-height: 1.15;
		letter-spacing: 0.02em;
		text-transform: uppercase;
		color: #1447b0;
		background: var(--brand-yellow);
		transition: transform 0.25s ease;
	}

	.badge:hover {
		transform: scale(1.08) rotate(-4deg);
	}

	.hero__vessel {
		grid-area: vessel;
	}

	.hero__comps {
		grid-area: comps;
	}


	/* ---------- welcome ---------- */
	.welcome-wrap {
		margin-top: 0.75rem;
	}

	/* The heading floats top-left and the paragraph wraps around it, using the whole
	   width of the tile: the first lines run along the heading's right, the rest flow
	   underneath it. */
	.welcome {
		padding: clamp(1.75rem, 4vw, 3.5rem);
		background: #fff;
		border: 2px solid #000;
	}

	/* Only this word: a blue -> yellow gradient with print grain, clipped to the letters, then
	   given a glow. */
	.welcome .display {
		/* padding gives the glow room so its edge isn't clipped to the text box; the negative
		   margin cancels it so the layout doesn't move */
		padding: 0.45em 0.6em;
		margin: -0.45em -0.6em calc(1.5rem - 0.45em);
		color: transparent;
		background:
			url('../assets/patterns/riso-grain.svg') 0 0 / 300px 300px repeat,
			linear-gradient(
				90deg,
				var(--brand-blue) 0%,
				var(--brand-blue) 34%,
				var(--brand-yellow) 62%,
				var(--brand-yellow) 100%
			);
		-webkit-background-clip: text;
		background-clip: text;
		/* soft glow like a blurred print: feathered letter edges, a violet-blue halo that fades outwards, and a thin orange fringe on the lower left */
		filter: blur(1.3px) drop-shadow(-3px 2px 1px rgb(255 138 43 / 1)) drop-shadow(0 0 2px rgb(40 40 200 / 0.8))
			drop-shadow(0 0 5px rgb(60 45 215 / 0.55)) drop-shadow(0 0 10px rgb(85 50 225 / 0.35));
	}

	@media (min-width: 48rem) {
		.welcome .display {
			float: left;
			margin: calc(0.1rem - 0.45em) calc(clamp(2rem, 4vw, 3.5rem) - 0.6em) calc(0.75rem - 0.45em) -0.6em;
		}
	}

	.welcome__body :global(p) {
		margin: 0;
		font-size: clamp(1.05rem, 1.35vw, 1.3rem);
		line-height: 1.65;
		color: var(--brand-navy);
	}

	/* ---------- narrow screens: hero stacks ---------- */
	@media (max-width: 63.99rem) {
		.hero {
			height: auto;
			grid-template-columns: 1fr 1fr;
			grid-template-rows: auto minmax(20rem, 60vw) 12rem;
			grid-template-areas:
				'head head'
				'photo photo'
				'vessel comps';
		}

		.hero__head {
			gap: 3.5rem;
		}

		.badge {
			top: 1.25rem;
			left: 1.25rem;
			width: 7.5rem;
			height: 7.5rem;
			font-size: 1rem;
		}
	}

	/* ---------- motion (skipped entirely for reduced-motion users) ---------- */
	@media (prefers-reduced-motion: no-preference) {
		.hero .tile,
		.welcome {
			animation: rise 0.9s cubic-bezier(0.2, 0.7, 0.2, 1) both;
		}

		.hero__photo {
			animation-delay: 0.08s;
		}

		.hero__vessel {
			animation-delay: 0.16s;
		}

		.hero__comps {
			animation-delay: 0.24s;
		}

		.welcome {
			animation-delay: 0.32s;
		}

		.hero__photo .fill {
			animation: settle 2.2s cubic-bezier(0.2, 0.7, 0.2, 1) both;
		}

		@keyframes rise {
			from {
				opacity: 0;
				transform: translateY(28px) scale(0.985);
			}
		}

		@keyframes settle {
			from {
				transform: scale(1.09);
			}
		}
	}
</style>
