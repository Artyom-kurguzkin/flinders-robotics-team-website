---
import { Image } from 'astro:assets';
import Layout from '../layouts/Layout.astro';
import { href } from '../href';
import { Content as HomeContent } from '../data/home.md';
import vesselImage from '../assets/vessel_main.jpeg';

const cards = [
	{
		title: 'About Us',
		icon: 'groups',
		path: 'about/',
		blurb: 'The team, the vessel, and how TopCat got here.',
	},
	{
		title: 'Technical Specifications',
		icon: 'settings',
		path: 'technical-specifications/',
		blurb: 'Competition tasks, system architecture, and safety systems.',
	},
	{
		title: 'Competitions',
		icon: 'emoji_events',
		path: 'competitions/',
		blurb: 'Singapore, Hawaii, and two virtual events — and what we learnt.',
	},
	{
		title: 'Research',
		icon: 'science',
		path: 'research/',
		blurb: 'Maritime autonomy research at CDERT.',
	},
];
---

<Layout title="Home">
	<section class="hero">
		<div class="hero__inner">
			<div class="hero__copy">
				<p class="label-large hero__eyebrow">Team Australis2 · Flinders University</p>
				<h1 class="display-small">Maritime RobotX Challenge</h1>
				<p class="hero__lead">
					TopCat — a five-metre autonomous surface vessel built to navigate, identify and act on
					its own, at sea.
				</p>
				<div class="hero__actions">
					<md-filled-button href={href('about/')}>
						<md-icon slot="icon">sailing</md-icon>
						Meet the team
					</md-filled-button>
					<md-outlined-button href={href('gallery/')}>
						<md-icon slot="icon">photo_library</md-icon>
						See the gallery
					</md-outlined-button>
				</div>
			</div>

			<Image
				class="hero__image"
				src={vesselImage}
				alt="TopCat, the Flinders University autonomous surface vessel, on the water"
				width={720}
				height={480}
				loading="eager"
			/>
		</div>
	</section>

	<div class="page">
		<section class="section prose">
			<h2>Welcome</h2>
			<HomeContent />
		</section>

		<section class="section">
			<h2>Explore</h2>
			<div class="card-grid">
				{
					cards.map((card) => (
						<a class="md-card md-card--elevated state-layer nav-card" href={href(card.path)}>
							<md-icon class="nav-card__icon">{card.icon}</md-icon>
							<h3 class="title-large">{card.title}</h3>
							<p class="body-medium">{card.blurb}</p>
						</a>
					))
				}
			</div>
		</section>
	</div>
</Layout>

<script>
	import '@material/web/button/filled-button.js';
	import '@material/web/button/outlined-button.js';
	import '@material/web/icon/icon.js';
</script>

<style>
	.hero {
		background: var(--md-sys-color-primary-container);
		color: var(--md-sys-color-on-primary-container);
	}

	.hero__inner {
		max-width: var(--content-width);
		margin-inline: auto;
		padding: clamp(2.5rem, 7vw, 4.5rem) 1.5rem;
		display: grid;
		gap: 2.5rem;
		align-items: center;
		grid-template-columns: 1fr;
	}

	@media (min-width: 52rem) {
		.hero__inner {
			grid-template-columns: 1fr 1fr;
		}
	}

	.hero__image {
		width: 100%;
		height: auto;
		aspect-ratio: 3 / 2;
		object-fit: cover;
		border-radius: var(--md-sys-shape-corner-large);
		box-shadow: var(--md-sys-elevation-2);
	}

	.hero__eyebrow {
		margin: 0 0 0.75rem;
		text-transform: uppercase;
		letter-spacing: 0.08em;
		opacity: 0.8;
	}

	.hero h1 {
		margin: 0 0 1rem;
		max-width: 20ch;
	}

	.hero__lead {
		font-size: 1.125rem;
		line-height: 1.6;
		max-width: 48ch;
		margin: 0 0 2rem;
	}

	.hero__actions {
		display: flex;
		flex-wrap: wrap;
		gap: 0.75rem;
	}

	.nav-card {
		display: block;
		text-decoration: none;
		color: var(--md-sys-color-on-surface);
	}

	.nav-card__icon {
		color: var(--md-sys-color-primary);
		--md-icon-size: 32px;
		margin-bottom: 0.5rem;
	}

	.nav-card h3 {
		margin-bottom: 0.25rem;
	}

	.nav-card p {
		margin: 0;
		color: var(--md-sys-color-on-surface-variant);
	}
</style>
