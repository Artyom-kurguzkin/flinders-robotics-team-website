---
import { Image } from 'astro:assets';
import Layout from '../layouts/Layout.astro';
import { href } from '../href';
import { Content as HomeContent } from '../data/home.md';
import Gallery from '../components/Gallery.astro';
import vessel from '../assets/conference.jpg';
import singapore from '../assets/singapore_course.jpg';
---

<Layout title="Home">
	<div class="shell">
		<!-- ============ Hero: bento of rounded tiles ============ -->
		<section class="hero" aria-label="Flinders Robotics Team">
			<div class="tile hero__head">
				<h1>
					<span class="h1__line">Flinders<span class="arrow" aria-hidden="true"></span></span>
					<span class="h1__line">Robotics Team</span>
				</h1>
				<a
					class="join riso-hover riso-hover--warm"
					href="https://campus.hellorubric.com/?tab=memberships&s=12176"
					target="_blank"
					rel="noopener noreferrer">Join Us</a
				>
				<span class="arrow-hook" aria-hidden="true"></span>
			</div>

			<div class="tile hero__photo">
				<video
					class="fill fill--team"
					src={href('media/team-loop.mp4')}
					poster={href('media/team-loop-poster.jpg')}
					autoplay
					muted
					loop
					playsinline
					aria-label="The Flinders Robotics Team walking together on campus"></video
				>
				<a class="badge riso-hover riso-hover--warm" href={href('about/')}>Meet the Team</a>
				<div class="hero__actions">
					<a class="pill pill--solid riso-hover riso-hover--warm" href={href('contact/')}>
						Contact
						<span class="pill__icon" aria-hidden="true">
							<svg viewBox="0 0 24 24"><path d="M4 6h16v12H4zM4 7l8 6 8-6" /></svg>
						</span>
					</a>
				</div>
			</div>

			<a class="tile tile--photo riso-hover hero__vessel" href={`${href('about/')}#panel-1`}>
				<Image class="fill" src={vessel} alt="" width={900} loading="eager" />
				<span class="label">The Vessel</span>
			</a>

			<a class="tile tile--photo riso-hover hero__comps" href={href('competitions/')}>
				<Image class="fill fill--nocredit" src={singapore} alt="" width={900} loading="eager" />
				<span class="label">Competitions</span>
			</a>
		</section>

		<!-- ============ Welcome ============ -->
		<section class="welcome-wrap">
			<div class="tile welcome">
				<div class="welcome__flow">
					<h2 class="display">Welcome <span class="display__emoji">😊</span></h2>
					<div class="welcome__body">
						<HomeContent />
					</div>
				</div>
			</div>
		</section>

		<Gallery />
	</div>

	<script>
		// Glass blur across the loop seam. The clip is short, so a CSS animation of the
		// same length drifts out of step with the video within a few loops; reading the
		// video's own clock each frame keeps the blur exactly on the cut.
		const video = document.querySelector<HTMLVideoElement>('.fill--team');
		const FADE = 0.32; // seconds of blur either side of the seam

		if (video) {
			// The `autoplay` attribute alone is refused often enough (power saving, a
			// background tab on load, Safari's rules) that it is worth asking directly
			// and keeping the poster if the answer is no.
			// 1.5x slower. playbackRate rather than a re-encode: no extra bytes, and the
			// blur below reads currentTime, which still spans 0..duration either way.
			video.defaultPlaybackRate = 1 / 1.5;
			video.playbackRate = 1 / 1.5;

			const start = () => video.play().catch(() => {});
			start();
			video.addEventListener('canplay', start, { once: true });

			// Only the blur pulse is gated on reduced motion — the clip itself is the
			// content, not an effect, so it keeps playing.
			if (!window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
				// Start fully glassed so the very first frames resolve out of the blur
				// the same way the loop seam does, rather than snapping in sharp.
				video.style.setProperty('--blur-k', '1');
				const tick = () => {
					const { currentTime: t, duration: d } = video;
					if (d) {
						const edge = Math.min(t, d - t);
						video.style.setProperty('--blur-k', String(Math.max(0, 1 - edge / FADE).toFixed(3)));
					}
					if (!document.hidden) requestAnimationFrame(tick);
				};
				requestAnimationFrame(tick);
				// rAF is parked while the tab is hidden; restart it on return
				document.addEventListener('visibilitychange', () => {
					if (!document.hidden) requestAnimationFrame(tick);
				});
			}
		}
	</script>
</Layout>

<style>
	.shell {
		max-width: var(--shell-width);
		margin-inline: auto;
		padding: 0 0.75rem 2.5rem;
	}

	/* ---------- tile language ---------- */
	.tile {
		position: relative;
		overflow: hidden;
		border-radius: 1.75rem;
		background: var(--brand-sky);
		isolation: isolate;
	}

	.fill {
		position: absolute;
		inset: 0;
		width: 100%;
		height: 100%;
		object-fit: cover;
		z-index: -2;
		transition: transform 0.7s cubic-bezier(0.2, 0.7, 0.2, 1);
	}

	/* a 16:9 clip in a tall tile: hold the group and the faces, which sit above centre */
	.fill--team {
		object-position: 50% 42%;
		/* Glass blur with a darkening fall-off, on the loop seam and on the first
		   frames after the page opens. --blur-k is driven from the video clock in the
		   script below, so it stays locked to the cut instead of drifting off it. */
		filter: blur(calc(var(--blur-k, 0) * 18px)) saturate(calc(1 + var(--blur-k, 0) * 0.3))
			brightness(calc(1 - var(--blur-k, 0) * 0.45)) contrast(calc(1 + var(--blur-k, 0) * 0.08));
		/* the blur samples transparent pixels at the edges without this */
		scale: 1.04;
	}

	/* This source photo has a credit strip baked into its bottom edge. Let the image
	   run past the tile (anchored at the top) so that edge is clipped. */
	.fill--nocredit {
		height: 118%;
		object-position: 25% top;
	}

	a.tile--photo:hover .fill {
		transform: scale(1.06);
	}

	.label {
		position: absolute;
		left: 1.25rem;
		bottom: 1.1rem;
		right: 1.25rem;
		color: #fff;
		font-weight: 800;
		font-size: clamp(1.15rem, 2vw, 1.85rem);
		letter-spacing: -0.02em;
		line-height: 1.1;
	}

	/* ---------- pills ---------- */
	.pill {
		display: inline-flex;
		align-items: center;
		gap: 1rem;
		height: 3.25rem;
		padding: 0 0.4rem 0 1.5rem;
		border-radius: 999px;
		font-size: 0.9375rem;
		font-weight: 600;
		text-decoration: none;
		white-space: nowrap;
		transition: transform 0.2s ease;
	}

	.pill:hover {
		transform: translateY(-2px);
	}

	.pill--solid {
		background: var(--brand-yellow);
		color: var(--brand-navy);
		border: 1px solid var(--md-sys-color-outline-variant);
	}

	.pill__icon {
		display: grid;
		place-items: center;
		width: 2.5rem;
		height: 2.5rem;
		border-radius: 50%;
		background: var(--brand-navy);
	}

	.pill__icon svg {
		width: 1.15rem;
		height: 1.15rem;
		fill: none;
		stroke: #fff;
		stroke-width: 2;
		stroke-linecap: round;
		stroke-linejoin: round;
	}

		/* ---------- hero ---------- */
	.hero {
		display: grid;
		gap: 0.75rem;
		height: clamp(34rem, calc(100dvh - 5.75rem), 54rem);
		grid-template-columns: 1fr 1fr 2fr;
		grid-template-rows: 1.45fr 1fr;
		grid-template-areas:
			'head head photo'
			'vessel comps photo';
	}

	.hero__head {
		grid-area: head;
		background: var(--brand-yellow);
		display: flex;
		flex-direction: column;
		justify-content: space-between;
		/* shared by the padding, the heading and the arrow hook's geometry */
		--pad: clamp(1.5rem, 3vw, 2.75rem);
		--h1-size: clamp(2.4rem, 5.3vw, 6.25rem);
		--join-size: 10rem;
		--rule: 0.4rem;
		--head: 1.6rem;
		padding: var(--pad);
	}

	.hero__head h1 {
		margin: 0;
		font-size: var(--h1-size);
		font-weight: 800;
		letter-spacing: -0.04em;
		line-height: 0.94;
		text-transform: uppercase;
		color: var(--brand-navy);
	}

	.h1__line {
		display: flex;
		align-items: center;
	}

	/* The horizontal run after "FLINDERS". It stops flush with the heading's right
	   edge so the hook below picks it up exactly. */
	.arrow {
		flex: 1;
		height: var(--rule);
		min-width: 2rem;
		margin-inline: 0.9rem 0;
		background: currentColor;
		border-radius: 999px;
	}

	/* ...and the hook carries on: down the right-hand side, back along the bottom,
	   and points into the Join Us circle. Anchored off the same custom properties
	   as the padding, heading size and button, so it tracks every breakpoint. */
	.arrow-hook {
		position: absolute;
		top: calc(var(--pad) + var(--h1-size) * 0.47);
		right: var(--pad);
		bottom: calc(var(--pad) + var(--join-size) / 2);
		left: calc(var(--pad) + var(--join-size));
		border-right: var(--rule) solid var(--brand-navy);
		border-bottom: var(--rule) solid var(--brand-navy);
		border-bottom-right-radius: 1.9rem;
		pointer-events: none;
	}

	/* the head: one solid triangle pointing at the button, not two crossed strokes.
	   `bottom: 0` puts its lower edge on the padding box, so the Y translate drops it
	   half its own height plus half the rule to centre it on the line. The X translate
	   pulls it left past the end of the line: the triangle tapers to nothing at the
	   tip, so without it the line is thicker than the head and shows through. */
	.arrow-hook::after {
		content: '';
		position: absolute;
		left: 0;
		bottom: 0;
		width: var(--head);
		height: var(--head);
		background: var(--brand-navy);
		clip-path: polygon(0 50%, 100% 0, 100% 100%);
		transform: translate(-45%, calc(50% + var(--rule) / 2));
	}

	/* the Meet the Team badge in Summer Red: same circle, size and hover */
	.join {
		align-self: flex-start;
		display: grid;
		place-items: center;
		width: var(--join-size);
		height: var(--join-size);
		padding: 0.75rem;
		border-radius: 50%;
		background: var(--brand-orange);
		color: #fff;
		text-align: center;
		text-decoration: none;
		font-size: 1.375rem;
		font-weight: 800;
		line-height: 1.15;
		letter-spacing: 0.02em;
		text-transform: uppercase;
		transition: transform 0.25s ease;
	}

	.join:hover {
		transform: scale(1.08) rotate(-4deg);
	}

	.hero__photo {
		grid-area: photo;
		background: var(--brand-navy);
	}

	.hero__actions {
		position: absolute;
		right: 1.25rem;
		bottom: 1.25rem;
		display: flex;
		flex-wrap: wrap;
		justify-content: flex-end;
		gap: 0.6rem;
	}

	.badge {
		position: absolute;
		left: 1.5rem;
		top: 60%;
		display: grid;
		place-items: center;
		width: 10rem;
		height: 10rem;
		padding: 0.75rem;
		border-radius: 50%;
		text-align: center;
		text-decoration: none;
		font-size: 1.375rem;
		font-weight: 800;
		line-height: 1.15;
		letter-spacing: 0.02em;
		text-transform: uppercase;
		color: #232d4b;
		background: var(--brand-yellow);
		transition: transform 0.25s ease;
	}

	.badge:hover {
		transform: scale(1.08) rotate(-4deg);
	}

	.hero__vessel {
		grid-area: vessel;
	}

	.hero__comps {
		grid-area: comps;
	}


	/* ---------- welcome ---------- */
	.welcome-wrap {
		margin-top: 0.75rem;
	}

	/* The heading floats top-left and the paragraph wraps around it, using the whole
	   width of the tile: the first lines run along the heading's right, the rest flow
	   underneath it. */
	.welcome {
		padding: clamp(1.75rem, 4vw, 3.5rem);
		background: #fff;
		border: 2px solid #000;
	}

	.welcome .display {
		margin-bottom: 1.5rem;
	}

	/* Emoji carry their own metrics and come out short next to cap-height letters;
	   sized up and nudged down so it reads the same height as WELCOME. */
	.display__emoji {
		font-size: 0.82em;
		line-height: 1;
		vertical-align: -0.04em;
	}

	@media (min-width: 48rem) {
		.welcome .display {
			float: left;
			margin: 0.1rem clamp(2rem, 4vw, 3.5rem) 0.75rem 0;
		}
	}

	.welcome__body :global(p) {
		margin: 0;
		font-size: clamp(1.05rem, 1.35vw, 1.3rem);
		line-height: 1.65;
		color: var(--brand-navy);
	}

	/* ---------- narrow screens: hero stacks ---------- */
	@media (max-width: 63.99rem) {
		.hero {
			height: auto;
			grid-template-columns: 1fr 1fr;
			grid-template-rows: auto minmax(20rem, 60vw) 12rem;
			grid-template-areas:
				'head head'
				'photo photo'
				'vessel comps';
		}

		/* The 3.5rem gap here was spacing the heading off the old lede paragraph. With
		   the Join Us button in its place it just made the card tall and pushed the
		   button away from the title. */
		.hero__head {
			gap: 1rem;
			--pad: 1.25rem;
		}

		/* the hook reads this, so the two stay in step */
		.hero__head {
			--join-size: 7.5rem;
		}

		.join {
			font-size: 1rem;
		}

		.badge {
			top: 1.25rem;
			left: 1.25rem;
			width: 7.5rem;
			height: 7.5rem;
			font-size: 1rem;
		}
	}

	/* ---------- motion (skipped entirely for reduced-motion users) ---------- */
	@media (prefers-reduced-motion: no-preference) {
		.hero .tile,
		.welcome {
			animation: rise 0.9s cubic-bezier(0.2, 0.7, 0.2, 1) both;
		}

		.hero__photo {
			animation-delay: 0.08s;
		}

		.hero__vessel {
			animation-delay: 0.16s;
		}

		.hero__comps {
			animation-delay: 0.24s;
		}

		.welcome {
			animation-delay: 0.32s;
		}

		.hero__photo .fill {
			animation: settle 2.2s cubic-bezier(0.2, 0.7, 0.2, 1) both;
		}

		@keyframes rise {
			from {
				opacity: 0;
				transform: translateY(28px) scale(0.985);
			}
		}

		@keyframes settle {
			from {
				transform: scale(1.09);
			}
		}
	}
</style>
