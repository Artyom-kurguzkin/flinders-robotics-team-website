---
import { Image } from 'astro:assets';
import Layout from '../layouts/Layout.astro';
import PageHeader from '../components/PageHeader.astro';
import karlPhoto from '../assets/team/Karl-Photo-2022-scaled.jpg';
import russellPhoto from '../assets/team/RussellBrinkworth-1.jpg';

const staff = [
	{
		name: 'Professor Karl Sammut',
		photo: karlPhoto,
		location: 'Tonsley (4.22)',
		telephone: '+61 8 82015051',
		email: 'karl.sammut@flinders.edu.au',
	},
	{
		name: 'Associate Professor Russell Brinkworth',
		photo: russellPhoto,
		location: 'Tonsley (4.31)',
		telephone: '+61 8 82017840',
		email: 'russell.brinkworth@flinders.edu.au',
	},
];
---

<Layout title="Contact">
	<PageHeader title="Contact" />

	<div class="page">
		<div class="cards">
			{
				staff.map((person) => (
					<article class="card">
						<div class="card__top">
							<Image
								class="card__photo"
								src={person.photo}
								alt={person.name}
								width={400}
								height={400}
								loading="lazy"
							/>
						</div>
						<div class="card__body">
							<h2>{person.name}</h2>
							<p class="card__uni">Flinders University</p>
							<ul class="facts">
								<li>
									<md-icon aria-hidden="true">location_on</md-icon>
									<span>Location: {person.location}</span>
								</li>
								<li>
									<md-icon aria-hidden="true">call</md-icon>
									<span>
										Telephone:{' '}
										<a href={`tel:${person.telephone.replace(/\s/g, '')}`}>{person.telephone}</a>
									</span>
								</li>
								<li>
									<md-icon aria-hidden="true">mail</md-icon>
									<span>
										Email: <a href={`mailto:${person.email}`}>{person.email}</a>
									</span>
								</li>
							</ul>
						</div>
					</article>
				))
			}
		</div>
	</div>
</Layout>

<style>
	.cards {
		display: grid;
		gap: 1.5rem;
		margin-top: 0.5rem;
		grid-template-columns: repeat(auto-fit, minmax(min(100%, 24rem), 1fr));
		align-items: start;
	}

	.card {
		overflow: hidden;
		border-radius: 1.75rem;
		background: #fff;
		box-shadow: var(--md-sys-elevation-1);
	}

	/* solid yellow top band; the portrait sits across its edge */
	.card__top {
		position: relative;
		height: 7.5rem;
		background: var(--brand-yellow);
	}

	.card__photo {
		position: absolute;
		left: 1.75rem;
		top: 3rem;
		width: 9rem;
		height: 9rem;
		border-radius: 50%;
		object-fit: cover;
		object-position: center 20%;
		border: 0.4rem solid #fff;
		background: #fff;
	}

	.card__body {
		/* clears the part of the portrait that hangs below the band */
		padding: 5.75rem 1.75rem 2rem;
	}

	.card__body h2 {
		margin: 0 0 0.6rem;
		font-size: clamp(1.4rem, 2.4vw, 1.75rem);
		line-height: 1.15;
	}

	.card__uni {
		display: inline-block;
		margin: 0 0 1.25rem;
		padding: 0.3rem 0.9rem;
		border-radius: 999px;
		font-weight: 700;
		font-size: 0.875rem;
		color: var(--brand-navy);
		background: var(--brand-butter);
	}

	.facts {
		list-style: none;
		margin: 0;
		padding: 0;
		display: grid;
		gap: 0.75rem;
	}

	.facts li {
		display: flex;
		align-items: center;
		gap: 0.85rem;
		line-height: 1.5;
		overflow-wrap: anywhere;
	}

	.facts md-icon {
		flex: none;
		display: grid;
		place-items: center;
		width: 2.5rem;
		height: 2.5rem;
		border-radius: 50%;
		font-size: 1.25rem;
		color: #fff;
		background: var(--brand-blue);
	}
</style>
