---
import { Image, getImage } from 'astro:assets';
import Layout from '../layouts/Layout.astro';
import PageHeader from '../components/PageHeader.astro';
import captions from '../data/gallery.json';

const files = import.meta.glob<{ default: ImageMetadata }>(
	'../assets/gallery/*.{jpg,jpeg,png}',
	{ eager: true }
);

const captionFor = captions as Record<string, string>;

// ponytail: originals are up to 5 MB, so the full-size view is a build-time
// optimised webp too — nothing here ships the raw upload.
const items = await Promise.all(
	Object.entries(files)
		.map(([path, mod]) => ({ file: path.split('/').pop()!, src: mod.default }))
		.sort((a, b) => a.file.localeCompare(b.file))
		.map(async ({ file, src }) => ({
			file,
			src,
			caption: captionFor[file] ?? file.replace(/[-_]/g, ' ').replace(/\.\w+$/, ''),
			full: (await getImage({ src, width: 1600, format: 'webp' })).src,
		}))
);
---

<Layout title="Gallery" description="Testing, deployment and competition photography from the Flinders Maritime RobotX team.">
	<PageHeader
		title="Gallery"
		eyebrow={`${items.length} photos`}
		lead="Tank tests, West Lakes, the Port River and the Torrens — where most of the real work happens."
	/>

	<div class="page">
		<ul class="grid">
			{
				items.map((item) => (
					<li>
						<button
							class="thumb state-layer"
							type="button"
							data-full={item.full}
							data-caption={item.caption}
						>
							<Image src={item.src} alt={item.caption} width={480} height={360} loading="lazy" />
							<span class="thumb__caption body-medium">{item.caption}</span>
						</button>
					</li>
				))
			}
		</ul>
	</div>

	<md-dialog id="lightbox">
		<div slot="content">
			<img id="lightbox-img" src="" alt="" />
			<p id="lightbox-caption" class="body-medium"></p>
		</div>
		<div slot="actions">
			<md-text-button id="lightbox-close">Close</md-text-button>
		</div>
	</md-dialog>
</Layout>

<script>
	import '@material/web/dialog/dialog.js';
	import '@material/web/button/text-button.js';

	const dialog = document.getElementById('lightbox') as HTMLElement & {
		show(): void;
		close(): void;
	};
	const img = document.getElementById('lightbox-img') as HTMLImageElement;
	const caption = document.getElementById('lightbox-caption') as HTMLElement;

	document.querySelectorAll<HTMLButtonElement>('.thumb').forEach((thumb) => {
		thumb.addEventListener('click', () => {
			img.src = thumb.dataset.full ?? '';
			img.alt = thumb.dataset.caption ?? '';
			caption.textContent = thumb.dataset.caption ?? '';
			dialog.show();
		});
	});

	document.getElementById('lightbox-close')?.addEventListener('click', () => dialog.close());
</script>

<style>
	.grid {
		list-style: none;
		padding: 0;
		margin: 0;
		display: grid;
		gap: 1rem;
		grid-template-columns: repeat(auto-fill, minmax(15rem, 1fr));
	}

	.thumb {
		display: block;
		width: 100%;
		padding: 0;
		border: none;
		cursor: pointer;
		background: var(--md-sys-color-surface-container-low);
		color: var(--md-sys-color-on-surface);
		border-radius: var(--md-sys-shape-corner-medium);
		overflow: hidden;
		font: inherit;
		text-align: left;
	}

	.thumb :global(img) {
		width: 100%;
		aspect-ratio: 4 / 3;
		object-fit: cover;
	}

	.thumb__caption {
		display: block;
		padding: 0.75rem 1rem;
		color: var(--md-sys-color-on-surface-variant);
	}

	md-dialog {
		max-width: min(60rem, 92vw);
	}

	#lightbox-img {
		width: 100%;
		height: auto;
		border-radius: var(--md-sys-shape-corner-small);
	}

	#lightbox-caption {
		margin: 0.75rem 0 0;
		color: var(--md-sys-color-on-surface-variant);
	}
</style>
