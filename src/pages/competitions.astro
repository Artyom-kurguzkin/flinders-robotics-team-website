---
import { getCollection, render } from 'astro:content';
import Layout from '../layouts/Layout.astro';
import PageHeader from '../components/PageHeader.astro';

const entries = (await getCollection('competitions')).sort((a, b) => a.data.order - b.data.order);
const rendered = await Promise.all(
	entries.map(async (entry) => ({ entry, Content: (await render(entry)).Content }))
);
---

<Layout title="Competitions">
	<PageHeader title="Competitions" />

	<div class="page">
		<section class="section prose">
			<p>
				Flinders University and Team Australis<sup>2</sup> has participated in many competition over
				the past years. Competitions are not only exciting and challenging but also give teams the
				opportunity to interact with like minded people and tackle real world problems.
			</p>
		</section>

		<div class="tabbar">
			<md-tabs aria-label="Competition">
				{
					rendered.map(({ entry }, i) => (
						<md-primary-tab
							id={`tab-${entry.id}`}
							aria-controls={`panel-${entry.id}`}
							active={i === 0 ? true : undefined}
						>
							{entry.data.title}
						</md-primary-tab>
					))
				}
			</md-tabs>
		</div>

		{
			rendered.map(({ entry, Content }) => (
				<section
					id={`panel-${entry.id}`}
					role="tabpanel"
					aria-labelledby={`tab-${entry.id}`}
					class="panel"
				>
					<div class="prose entry">
						<Content />
					</div>
				</section>
			))
		}
	</div>
</Layout>

<script>
	import '@material/web/tabs/tabs.js';
	import '@material/web/tabs/primary-tab.js';

	// Panels render visible by default, so the page still reads fully without JS.
	// Once tabs are live, show one at a time.
	const tabs = document.querySelector('md-tabs');
	const panels = [...document.querySelectorAll<HTMLElement>('[role="tabpanel"]')];

	function show(index: number) {
		panels.forEach((panel, i) => (panel.hidden = i !== index));
	}

	if (tabs && panels.length) {
		show(0);
		tabs.addEventListener('change', () => {
			show((tabs as HTMLElement & { activeTabIndex: number }).activeTabIndex);
		});
	}
</script>

<style>
	.entry {
		max-width: 52rem;
	}

	.entry :global(h2) {
		margin-bottom: 0.25rem;
	}

	/* location, date and section headings */
	.entry :global(h3) {
		font-size: 1.125rem;
		margin: 1.75rem 0 0.5rem;
	}

	.entry :global(h2 + h3),
	.entry :global(h3 + h3) {
		margin-top: 0;
		color: var(--md-sys-color-on-surface-variant);
		font-weight: 500;
	}

	.entry :global(ul) {
		padding-left: 1.2rem;
	}

	.entry :global(li) {
		margin-bottom: 0.5rem;
	}

	.entry :global(img) {
		width: 100%;
		max-width: 40rem;
		height: auto;
		border-radius: var(--md-sys-shape-corner-large);
		margin-block: 0.5rem 1rem;
	}
</style>
