---
import '../styles/global.css';
import Footer from '../components/Footer.astro';

interface Props {
	title: string;
	description?: string;
}

const {
	title,
	description = 'The Flinders Robotics Team: the TopCat autonomous surface vessel and the competitions we enter, including Maritime RobotX.',
} = Astro.props;

const base = import.meta.env.BASE_URL;
const href = (path: string) => `${base}${path}`.replace(/\/{2,}/g, '/');

const nav = [
	{ label: 'Home', path: '', icon: 'home' },
	{ label: 'About Us', path: 'about/', icon: 'groups' },
	{ label: 'Technical Specifications', path: 'technical-specifications/', icon: 'settings' },
	{ label: 'Research', path: 'research/', icon: 'science' },
	{ label: 'Competitions', path: 'competitions/', icon: 'emoji_events' },
	{ label: 'Contact', path: 'contact/', icon: 'mail' },
];

// Contact is the pill's button; the rest sit centred. The drawer lists all of them.
const cta = nav[nav.length - 1];
const centre = nav.slice(0, -1);

const current = Astro.url.pathname.replace(/\/{2,}/g, '/');
const isActive = (path: string) => current === href(path);
---

<!doctype html>
<html lang="en">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<!-- SVG first for browsers that take it (scales to any size); .ico and PNG
		     are the fallbacks, and /favicon.ico also covers direct probes. -->
		<link rel="icon" href={href('favicon.svg')} type="image/svg+xml" />
		<link rel="icon" href={href('favicon.ico')} sizes="any" />
		<link rel="apple-touch-icon" href={href('icon-180.png')} />
		<meta name="theme-color" content="#16294d" />
		<meta name="description" content={description} />
		<title>{title} | Flinders Robotics Team</title>

		<link rel="preconnect" href="https://fonts.googleapis.com" />
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
		<link
			href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:ital,wght@0,400;0,500;0,600;0,700;0,800;1,400;1,500;1,600;1,700;1,800&display=swap"
			rel="stylesheet"
		/>
		<!-- display=block: hide the icon glyphs until the font arrives, instead of
		     briefly showing the ligature names as text ("place", "calendar_month"). -->
		<link
			href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:opsz,wght,FILL,GRAD@24,400,0,0&display=block"
			rel="stylesheet"
		/>
	</head>
	<body>
		<a class="skip-link" href="#main">Skip to content</a>

		<header class="app-bar">
			<div class="app-bar__pill">
				<a class="brand" href={href('')}>
					<img class="brand__mark" src={href('brand/frt-mark.svg')} alt="" width="28" height="28" />
					<span class="brand__title">Flinders Robotics Team</span>
				</a>

				<nav class="nav-desktop" aria-label="Main">
					{
						centre.map((item) => (
							<a
								href={href(item.path)}
								class:list={['nav-link', 'state-layer', { 'is-active': isActive(item.path) }]}
								aria-current={isActive(item.path) ? 'page' : undefined}
							>
								{item.label}
							</a>
						))
					}
				</nav>

				<a
					class:list={['nav-cta', { 'is-active': isActive(cta.path) }]}
					href={href(cta.path)}
					aria-current={isActive(cta.path) ? 'page' : undefined}
				>
					{cta.label}
				</a>

				<md-icon-button id="nav-toggle" class="nav-toggle" aria-label="Open navigation menu">
					<md-icon>menu</md-icon>
				</md-icon-button>
			</div>
		</header>

		<dialog id="nav-drawer" class="drawer" aria-label="Navigation">
			<div class="drawer__head">
				<span class="title-large">Menu</span>
				<md-icon-button id="nav-close" aria-label="Close navigation menu">
					<md-icon>close</md-icon>
				</md-icon-button>
			</div>
			<md-list>
				{
					nav.map((item) => (
						<md-list-item
							type="link"
							href={href(item.path)}
							aria-current={isActive(item.path) ? 'page' : undefined}
						>
							<md-icon slot="start">{item.icon}</md-icon>
							{item.label}
						</md-list-item>
					))
				}
			</md-list>
		</dialog>

		<main id="main">
			<slot />
		</main>

		<Footer />

		<script>
			import '@material/web/icon/icon.js';
			import '@material/web/iconbutton/icon-button.js';
			import '@material/web/list/list.js';
			import '@material/web/list/list-item.js';
			import '@material/web/divider/divider.js';

			const drawer = document.getElementById('nav-drawer') as HTMLDialogElement;
			document
				.getElementById('nav-toggle')
				?.addEventListener('click', () => drawer.showModal());
			document.getElementById('nav-close')?.addEventListener('click', () => drawer.close());
			// click the backdrop (the dialog element itself) to dismiss
			drawer?.addEventListener('click', (event) => {
				if (event.target === drawer) drawer.close();
			});

			// Hide the header while scrolling down; bring it back on any scroll up, near the
			// top of the page, or when something inside it takes keyboard focus.
			const bar = document.querySelector<HTMLElement>('.app-bar');
			let lastY = window.scrollY;
			let anchor = lastY; // where the current scroll direction began
			let dir = 0;
			let queued = false;
			window.addEventListener(
				'scroll',
				() => {
					if (queued) return;
					queued = true;
					requestAnimationFrame(() => {
						const y = window.scrollY;
						const d = Math.sign(y - lastY);
						if (d && d !== dir) {
							dir = d;
							anchor = lastY;
						}
						// hide only after a real stretch of scrolling down, show on a short way back up
						if (y < 90 || (dir < 0 && anchor - y > 24)) bar?.classList.remove('is-hidden');
						else if (dir > 0 && y - anchor > 80) bar?.classList.add('is-hidden');
						lastY = y;
						queued = false;
					});
				},
				{ passive: true }
			);
			bar?.addEventListener('focusin', () => bar.classList.remove('is-hidden'));
		</script>

		<style>
			.skip-link {
				position: absolute;
				left: -9999px;
				top: 0;
				z-index: 100;
				background: var(--md-sys-color-primary);
				color: var(--md-sys-color-on-primary);
				padding: 0.75rem 1rem;
				border-radius: 0 0 var(--md-sys-shape-corner-small) 0;
			}

			.skip-link:focus {
				left: 0;
			}

			/* === Floating pill header ===
			   ponytail: hand-rolled. @material/web 2.5 has no stable top app bar
			   (labs/navigationbar only). The wrapper is transparent and sticky; only the
			   rounded pill inside it is visible, so content scrolls under it. */
			.app-bar {
				position: sticky;
				top: 0;
				z-index: 10;
				padding: 0.75rem 0.75rem 0;
				/* the gap between the pill and whatever follows, on every page */
				margin-bottom: 0.75rem;
				pointer-events: none;
				transition:
					transform 0.7s cubic-bezier(0.22, 0.8, 0.24, 1),
					opacity 0.55s ease,
					visibility 0s;
			}

			/* slid up out of view (its own shadow included) while scrolling down */
			.app-bar.is-hidden {
				transform: translateY(calc(-100% - 1rem));
				opacity: 0;
				visibility: hidden;
				/* visibility flips only once the slide has finished */
				transition:
					transform 0.7s cubic-bezier(0.22, 0.8, 0.24, 1),
					opacity 0.55s ease,
					visibility 0s 0.7s;
			}

			@media (prefers-reduced-motion: reduce) {
				.app-bar {
					transition: none;
				}
			}

			.app-bar__pill {
				pointer-events: auto;
				max-width: var(--shell-width);
				margin-inline: auto;
				height: 3.5rem;
				padding: 0 0.5rem 0 1.1rem;
				display: grid;
				grid-template-columns: auto 1fr auto auto;
				align-items: center;
				gap: 1rem;
				background: rgb(255 255 255 / 0.94);
				-webkit-backdrop-filter: blur(10px);
				backdrop-filter: blur(10px);
				border: 1px solid var(--md-sys-color-outline-variant);
				border-radius: 1.25rem;
				box-shadow: 0 6px 24px rgb(22 41 77 / 0.07);
			}

			.brand {
				display: flex;
				align-items: center;
				gap: 0.6rem;
				text-decoration: none;
				color: var(--brand-navy);
			}

			.brand__mark {
				width: 1.75rem;
				height: 1.75rem;
				flex: none;
				object-fit: contain;
			}

			.brand__title {
				font-weight: 800;
				font-size: 1rem;
				letter-spacing: -0.015em;
				white-space: nowrap;
			}

			.nav-desktop {
				display: none;
				justify-content: center;
				gap: 0.15rem;
			}

			.nav-link {
				display: inline-flex;
				align-items: center;
				padding: 0.4rem 0.8rem;
				border-radius: 999px;
				text-decoration: none;
				color: var(--brand-navy);
				font-size: 0.875rem;
				font-weight: 600;
				white-space: nowrap;
			}

			.nav-link:hover {
				background: var(--brand-sky);
			}

			.nav-link.is-active,
			.nav-cta.is-active {
				background: var(--brand-yellow);
				color: #1447b0;
			}


			.nav-cta {
				display: none;
				align-items: center;
				height: 2.5rem;
				padding: 0 1.25rem;
				border-radius: 999px;
				background: var(--brand-orange);
				color: var(--brand-navy);
				text-decoration: none;
				font-size: 0.875rem;
				font-weight: 700;
			}

			.nav-cta:hover {
				background: #ff9d4d;
			}

			/* Full nav needs room for 7 items; below this the drawer takes over. */
			@media (min-width: 62rem) {
				.nav-desktop {
					display: flex;
				}

				.nav-cta {
					display: inline-flex;
				}

				.nav-toggle {
					display: none;
				}

				.app-bar__pill {
					grid-template-columns: 1fr auto 1fr;
				}

				.nav-cta {
					justify-self: end;
				}
			}

			@media (max-width: 61.99rem) {
				.nav-toggle {
					grid-column: 4;
				}
			}

			/* === Drawer ===
			   native <dialog>: focus trap, Esc-to-close and inert background are free. */
			.drawer {
				margin: 0 0 0 auto;
				height: 100dvh;
				max-height: 100dvh;
				width: min(20rem, 85vw);
				border: none;
				padding: 0.5rem;
				background: var(--md-sys-color-surface-container-low);
				color: var(--md-sys-color-on-surface);
				border-radius: var(--md-sys-shape-corner-large) 0 0 var(--md-sys-shape-corner-large);
			}

			.drawer::backdrop {
				background: rgb(0 0 0 / 0.4);
			}

			.drawer__head {
				display: flex;
				align-items: center;
				justify-content: space-between;
				padding: 0.75rem 0.5rem 0.75rem 1rem;
			}

			main {
				flex: 1 0 auto;
			}
		</style>
	</body>
</html>
