---
import '../styles/global.css';
import Footer from '../components/Footer.astro';

interface Props {
	title: string;
	description?: string;
}

const {
	title,
	description = 'Team Australis2 — the Flinders University Maritime RobotX Challenge team and the TopCat autonomous surface vessel.',
} = Astro.props;

const base = import.meta.env.BASE_URL;
const href = (path: string) => `${base}${path}`.replace(/\/{2,}/g, '/');

const nav = [
	{ label: 'Home', path: '', icon: 'home' },
	{ label: 'About Us', path: 'about/', icon: 'groups' },
	{ label: 'Technical Specifications', path: 'technical-specifications/', icon: 'settings' },
	{ label: 'Research', path: 'research/', icon: 'science' },
	{ label: 'Competitions', path: 'competitions/', icon: 'emoji_events' },
	{ label: 'Gallery', path: 'gallery/', icon: 'photo_library' },
	{ label: 'Contact', path: 'contact/', icon: 'mail' },
];

const current = Astro.url.pathname.replace(/\/{2,}/g, '/');
const isActive = (path: string) => current === href(path);
---

<!doctype html>
<html lang="en">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<link rel="icon" href={href('favicon.svg')} type="image/svg+xml" />
		<meta name="description" content={description} />
		<title>{title} | Maritime RobotX Challenge</title>

		<link rel="preconnect" href="https://fonts.googleapis.com" />
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
		<link
			href="https://fonts.googleapis.com/css2?family=Roboto:wght@300;400;500;700&family=Material+Symbols+Outlined:opsz,wght,FILL,GRAD@24,400,0,0&display=swap"
			rel="stylesheet"
		/>
	</head>
	<body>
		<a class="skip-link" href="#main">Skip to content</a>

		<header class="app-bar">
			<div class="app-bar__inner">
				<a class="brand" href={href('')}>
					<span class="material-symbols-outlined brand__mark" aria-hidden="true">sailing</span>
					<span class="brand__text">
						<span class="brand__title">Maritime RobotX Challenge</span>
						<span class="brand__sub">Flinders University</span>
					</span>
				</a>

				<nav class="nav-desktop" aria-label="Main">
					{
						nav.map((item) => (
							<a
								href={href(item.path)}
								class:list={['nav-link', 'state-layer', { 'is-active': isActive(item.path) }]}
								aria-current={isActive(item.path) ? 'page' : undefined}
							>
								{item.label}
							</a>
						))
					}
				</nav>

				<md-icon-button id="nav-toggle" class="nav-toggle" aria-label="Open navigation menu">
					<md-icon>menu</md-icon>
				</md-icon-button>
			</div>
		</header>

		<dialog id="nav-drawer" class="drawer" aria-label="Navigation">
			<div class="drawer__head">
				<span class="title-large">Menu</span>
				<md-icon-button id="nav-close" aria-label="Close navigation menu">
					<md-icon>close</md-icon>
				</md-icon-button>
			</div>
			<md-list>
				{
					nav.map((item) => (
						<md-list-item
							type="link"
							href={href(item.path)}
							aria-current={isActive(item.path) ? 'page' : undefined}
						>
							<md-icon slot="start">{item.icon}</md-icon>
							{item.label}
						</md-list-item>
					))
				}
			</md-list>
		</dialog>

		<main id="main">
			<slot />
		</main>

		<Footer />

		<script>
			import '@material/web/icon/icon.js';
			import '@material/web/iconbutton/icon-button.js';
			import '@material/web/list/list.js';
			import '@material/web/list/list-item.js';
			import '@material/web/divider/divider.js';

			const drawer = document.getElementById('nav-drawer') as HTMLDialogElement;
			document
				.getElementById('nav-toggle')
				?.addEventListener('click', () => drawer.showModal());
			document.getElementById('nav-close')?.addEventListener('click', () => drawer.close());
			// click the backdrop (the dialog element itself) to dismiss
			drawer?.addEventListener('click', (event) => {
				if (event.target === drawer) drawer.close();
			});
		</script>

		<style>
			.skip-link {
				position: absolute;
				left: -9999px;
				top: 0;
				z-index: 100;
				background: var(--md-sys-color-primary);
				color: var(--md-sys-color-on-primary);
				padding: 0.75rem 1rem;
				border-radius: 0 0 var(--md-sys-shape-corner-small) 0;
			}

			.skip-link:focus {
				left: 0;
			}

			/* === Top app bar ===
			   ponytail: hand-rolled. @material/web 2.5 has no stable top app bar
			   (labs/navigationbar only), and this is a row of links on M3 tokens. */
			.app-bar {
				position: sticky;
				top: 0;
				z-index: 10;
				background: var(--md-sys-color-surface-container);
				color: var(--md-sys-color-on-surface);
				box-shadow: var(--md-sys-elevation-1);
			}

			.app-bar__inner {
				max-width: var(--content-width);
				margin-inline: auto;
				min-height: var(--app-bar-height);
				padding-inline: 1rem;
				display: flex;
				align-items: center;
				gap: 1rem;
			}

			.brand {
				display: flex;
				align-items: center;
				gap: 0.75rem;
				text-decoration: none;
				color: inherit;
				margin-right: auto;
				padding-block: 0.5rem;
			}

			.brand__mark {
				font-size: 2rem;
				color: var(--md-sys-color-primary);
			}

			.brand__text {
				display: flex;
				flex-direction: column;
				line-height: 1.2;
			}

			.brand__title {
				font-weight: 500;
				font-size: 1rem;
			}

			.brand__sub {
				font-size: 0.75rem;
				color: var(--md-sys-color-on-surface-variant);
			}

			.nav-desktop {
				display: none;
				gap: 0.25rem;
			}

			.nav-link {
				display: inline-flex;
				align-items: center;
				padding: 0.5rem 0.75rem;
				border-radius: var(--md-sys-shape-corner-small);
				text-decoration: none;
				color: var(--md-sys-color-on-surface-variant);
				font-size: 0.875rem;
				font-weight: 500;
				white-space: nowrap;
			}

			.nav-link.is-active {
				background: var(--md-sys-color-secondary-container);
				color: var(--md-sys-color-on-secondary-container);
			}

			/* Full nav needs room for 7 items; below this the drawer takes over. */
			@media (min-width: 62rem) {
				.nav-desktop {
					display: flex;
				}

				.nav-toggle {
					display: none;
				}
			}

			/* === Drawer ===
			   native <dialog>: focus trap, Esc-to-close and inert background are free. */
			.drawer {
				margin: 0 0 0 auto;
				height: 100dvh;
				max-height: 100dvh;
				width: min(20rem, 85vw);
				border: none;
				padding: 0.5rem;
				background: var(--md-sys-color-surface-container-low);
				color: var(--md-sys-color-on-surface);
				border-radius: var(--md-sys-shape-corner-large) 0 0 var(--md-sys-shape-corner-large);
			}

			.drawer::backdrop {
				background: rgb(0 0 0 / 0.4);
			}

			.drawer__head {
				display: flex;
				align-items: center;
				justify-content: space-between;
				padding: 0.75rem 0.5rem 0.75rem 1rem;
			}

			main {
				display: block;
				min-height: 60vh;
			}
		</style>
	</body>
</html>
