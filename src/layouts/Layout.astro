---
import '../styles/global.css';
import Footer from '../components/Footer.astro';

interface Props {
	title: string;
	description?: string;
}

const {
	title,
	description = 'The Flinders Robotics Team: the TopCat autonomous surface vessel and the competitions we enter, including Maritime RobotX.',
} = Astro.props;

const base = import.meta.env.BASE_URL;
const href = (path: string) => `${base}${path}`.replace(/\/{2,}/g, '/');

const nav = [
	{ label: 'Home', path: '', icon: 'home' },
	{ label: 'About Us', path: 'about/', icon: 'groups' },
	{ label: 'Technical Specifications', path: 'technical-specifications/', icon: 'settings' },
	{ label: 'Research', path: 'research/', icon: 'science' },
	{ label: 'Competitions', path: 'competitions/', icon: 'emoji_events' },
	{ label: 'Contact', path: 'contact/', icon: 'mail' },
];

// Contact is the pill's button; the rest sit centred. The drawer lists all of them.
const cta = nav[nav.length - 1];
const centre = nav.slice(0, -1);

const current = Astro.url.pathname.replace(/\/{2,}/g, '/');
const isActive = (path: string) => current === href(path);
---

<!doctype html>
<html lang="en">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
		<!-- SVG first for browsers that take it (scales to any size); .ico and PNG
		     are the fallbacks, and /favicon.ico also covers direct probes. -->
		<link rel="icon" href={href('favicon.svg')} type="image/svg+xml" />
		<link rel="icon" href={href('favicon.ico')} sizes="any" />
		<link rel="apple-touch-icon" href={href('icon-180.png')} />
		<meta name="theme-color" content="#232d4b" />
		<meta name="description" content={description} />
		<title>{title} | Flinders Robotics Team</title>

		<link rel="preconnect" href="https://fonts.googleapis.com" />
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
		<link
			href="https://fonts.googleapis.com/css2?family=DM+Sans:ital,wght@0,400;0,500;0,600;0,700;0,800;1,400&display=swap"
			rel="stylesheet"
		/>
		<!-- display=block: hide the icon glyphs until the font arrives, instead of
		     briefly showing the ligature names as text ("place", "calendar_month"). -->
		<link
			href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:opsz,wght,FILL,GRAD@24,400,0,0&display=block"
			rel="stylesheet"
		/>
	</head>
	<body>
		<a class="skip-link" href="#main">Skip to content</a>

		<header class="app-bar">
			<div class="app-bar__pill">
				<a class="brand" href={href('')} aria-label="Flinders Robotics Team, home">
					<img class="brand__mark" src={href('brand/frt-mark.svg')} alt="" width="28" height="28" />
					<span class="brand__title">Flinders Robotics Team</span>
				</a>

				<nav class="nav-desktop" aria-label="Main">
					{
						centre.map((item) => (
							<a
								href={href(item.path)}
								class:list={['nav-link', { 'nav-link--home': item.path === '', 'is-active': isActive(item.path) }]}
								aria-current={isActive(item.path) ? 'page' : undefined}
							>
								{item.label}
							</a>
						))
					}
				</nav>

				<a
					class:list={['nav-cta', { 'is-active': isActive(cta.path) }]}
					href={href(cta.path)}
					aria-current={isActive(cta.path) ? 'page' : undefined}
				>
					{cta.label}
				</a>

				<!-- Narrow screens get the same destinations as icons in the bar, so there
				     is no menu to open. The label is on the link, not visible text. -->
				<nav class="nav-icons" aria-label="Main">
					{
						nav.map((item) => (
							<a
								href={href(item.path)}
								class:list={[
								'nav-icon',
								{ 'nav-icon--home': item.path === '', 'is-active': isActive(item.path) },
							]}
								aria-label={item.label}
								aria-current={isActive(item.path) ? 'page' : undefined}
							>
								<span class="material-symbols-outlined" aria-hidden="true">
									{item.icon}
								</span>
							</a>
						))
					}
				</nav>
			</div>
		</header>

		<main id="main">
			<slot />
		</main>

		<Footer />

		<script>
			// Hide the header while scrolling down; bring it back on any scroll up, near the
			// top of the page, or when something inside it takes keyboard focus.
			const bar = document.querySelector<HTMLElement>('.app-bar');
			let lastY = window.scrollY;
			let anchor = lastY; // where the current scroll direction began
			let dir = 0;
			let queued = false;
			window.addEventListener(
				'scroll',
				() => {
					if (queued) return;
					queued = true;
					requestAnimationFrame(() => {
						const y = window.scrollY;
						const d = Math.sign(y - lastY);
						if (d && d !== dir) {
							dir = d;
							anchor = lastY;
						}
						// hide only after a real stretch of scrolling down, show on a short way back up
						if (y < 90 || (dir < 0 && anchor - y > 24)) bar?.classList.remove('is-hidden');
						else if (dir > 0 && y - anchor > 80) bar?.classList.add('is-hidden');
						lastY = y;
						queued = false;
					});
				},
				{ passive: true }
			);
			bar?.addEventListener('focusin', () => bar.classList.remove('is-hidden'));

			// Phones: once the header has scrolled off the top, its pill docks to the bottom
			// edge, in thumb reach. The wrapper keeps its height, so nothing jumps. On wider
			// screens the wrapper is sticky and never leaves the viewport, so this never fires.
			if (bar) {
				new IntersectionObserver(([entry]) =>
					bar.classList.toggle('is-docked', !entry.isIntersecting)
				).observe(bar);
			}
		</script>

		<style>
			.skip-link {
				position: absolute;
				left: -9999px;
				top: 0;
				z-index: 100;
				background: var(--md-sys-color-primary);
				color: var(--md-sys-color-on-primary);
				padding: 0.75rem 1rem;
				border-radius: 0 0 var(--md-sys-shape-corner-small) 0;
			}

			.skip-link:focus {
				left: 0;
			}

			/* === Floating pill header ===
			   ponytail: hand-rolled. @material/web 2.5 has no stable top app bar
			   (labs/navigationbar only). The wrapper is transparent and sticky; only the
			   rounded pill inside it is visible, so content scrolls under it. */
			.app-bar {
				position: sticky;
				top: 0;
				z-index: 10;
				padding: 0.75rem 0.75rem 0;
				/* the gap between the pill and whatever follows, on every page */
				margin-bottom: 0.75rem;
				pointer-events: none;
				transition:
					transform 0.7s cubic-bezier(0.22, 0.8, 0.24, 1),
					opacity 0.55s ease,
					visibility 0s;
			}

			/* slid up out of view (its own shadow included) while scrolling down. Not on
			   phones: there the bar docks to the bottom instead, and a transform on the
			   wrapper would pin the docked (fixed) pill to it. */
			@media (min-width: 40rem) {
				.app-bar.is-hidden {
					transform: translateY(calc(-100% - 1rem));
					opacity: 0;
					visibility: hidden;
					/* visibility flips only once the slide has finished */
					transition:
						transform 0.7s cubic-bezier(0.22, 0.8, 0.24, 1),
						opacity 0.55s ease,
						visibility 0s 0.7s;
				}
			}

			@media (prefers-reduced-motion: reduce) {
				.app-bar {
					transition: none;
				}
			}

			.app-bar__pill {
				pointer-events: auto;
				max-width: var(--shell-width);
				margin-inline: auto;
				height: 3.5rem;
				/* tight on mobile so the icon row has room to breathe; the roomier
				   desktop values come back in the 46rem query */
				padding: 0 0.5rem;
				display: grid;
				grid-template-columns: auto 1fr;
				align-items: center;
				gap: 0.5rem;
				/* solid white: it now floats over the gold band, and at 94% it took on a
				   cream tint from it */
				background: #fff;
				border: 1px solid var(--md-sys-color-outline-variant);
				border-radius: 1.25rem;
				box-shadow: 0 6px 24px rgb(22 41 77 / 0.07);
			}

			.brand {
				display: flex;
				align-items: center;
				gap: 0.6rem;
				text-decoration: none;
				color: var(--brand-navy);
			}

			.brand__mark {
				width: 1.75rem;
				height: 1.75rem;
				flex: none;
				object-fit: contain;
			}

			.brand__title {
				font-weight: 800;
				font-size: 1rem;
				letter-spacing: -0.015em;
				white-space: nowrap;
			}

			.nav-desktop {
				display: none;
				justify-content: center;
				gap: 0.15rem;
			}

			.nav-link {
				display: inline-flex;
				align-items: center;
				padding: 0.4rem 0.8rem;
				border-radius: 999px;
				text-decoration: none;
				color: var(--brand-navy);
				font-size: 0.875rem;
				font-weight: 600;
				white-space: nowrap;
			}

			/* One hover treatment across the site: fill with Midnight Navy, text goes
			   white. The gallery chips use the same pair. */
			.nav-link:hover,
			.nav-cta:not(.is-active):hover {
				background: var(--brand-navy);
				color: #fff;
			}

			.nav-link.is-active,
			.nav-cta.is-active {
				background: var(--brand-yellow);
				color: #232d4b;
			}


			/* Summer Red with white text — the standalone call-to-action button on
			   flinders.edu.au (Brand Guidelines p.54). Navy on Summer Red reads muddy. */
			.nav-cta {
				display: none;
				align-items: center;
				height: 2.5rem;
				padding: 0 1.25rem;
				border-radius: 999px;
				background: var(--brand-orange);
				color: #fff;
				text-decoration: none;
				font-size: 0.875rem;
				font-weight: 700;
			}

			/* === Icon nav (narrow screens) ===
			   Every destination is reachable straight from the bar, so there is no
			   menu, no dialog and no toggle. */
			.nav-icons {
				display: flex;
				justify-self: end;
				align-items: center;
				gap: 0.5rem;
			}

			/* 44px: the smallest target a finger hits reliably, with a real gap between
			   neighbours so the wrong one doesn't get tapped */
			.nav-icon {
				display: grid;
				place-items: center;
				width: 2.75rem;
				height: 2.75rem;
				border-radius: 50%;
				color: var(--brand-navy);
				text-decoration: none;
			}

			.nav-icon .material-symbols-outlined {
				font-size: 1.5rem;
			}

			.nav-icon:hover {
				background: var(--brand-navy);
				color: #fff;
			}

			.nav-icon.is-active {
				background: var(--brand-yellow);
				color: #232d4b;
			}

			/* A phone cannot hold the wordmark, six 44px targets and real gaps between
			   them at once — at 360px the row overflows by 12px. So below this the
			   wordmark goes, and Home goes with it: the mark beside it is already the
			   home link, which is what its aria-label says. That buys back 50px and
			   leaves the remaining five properly spaced. */
			@media (max-width: 39.99rem) {
				.brand__title,
				.nav-icon--home {
					display: none;
				}

				/* Bottom dock (the Material navigation bar / iOS tab bar pattern): the
				   header scrolls away with the page, and once it is gone the same pill
				   sits fixed above the bottom edge, clear of the home indicator. It stays
				   put rather than hiding on scroll: reach is the point. */
				.app-bar {
					position: static;
					height: 4.25rem; /* padding + pill, held while the pill is docked */
				}

				.app-bar.is-docked .app-bar__pill {
					position: fixed;
					left: 0.75rem;
					right: 0.75rem;
					bottom: calc(0.75rem + env(safe-area-inset-bottom));
					animation: dock-in 0.45s cubic-bezier(0.22, 0.8, 0.24, 1);
				}

				/* room under the footer's last line so the docked bar never covers it */
				:global(.footer) {
					padding-bottom: calc(5rem + env(safe-area-inset-bottom));
				}
			}

			@keyframes dock-in {
				from {
					transform: translateY(calc(100% + 1.5rem));
				}
			}

			@media (prefers-reduced-motion: reduce) {
				.app-bar__pill {
					animation: none !important;
				}
			}

			/* only the very narrowest phones (320px) need the gap trimmed to fit */
			@media (max-width: 20.99rem) {
				.nav-icons {
					gap: 0.3rem;
				}
			}

			/* Full nav from tablet width up; below this the icon row takes over. */
			@media (min-width: 46rem) {
				.nav-desktop {
					display: flex;
				}

				.nav-cta {
					display: inline-flex;
					justify-self: end;
				}

				.nav-icons {
					display: none;
				}

				.app-bar__pill {
					grid-template-columns: 1fr auto 1fr;
					padding: 0 0.5rem 0 1.1rem;
					gap: 1rem;
				}
			}

			/* Tablet: the same layout packed tighter so it holds down to 46rem. Home goes,
			   as on phones: the mark beside the wordmark is already the home link. */
			@media (min-width: 46rem) and (max-width: 61.99rem) {
				.app-bar__pill {
					gap: 0.5rem;
					padding-left: 0.8rem;
				}

				.brand {
					gap: 0.45rem;
				}

				.brand__title {
					font-size: 0.9rem;
				}

				.nav-desktop {
					gap: 0;
				}

				.nav-link--home {
					display: none;
				}

				/* tightest at 46rem, easing back to the desktop size by ~57rem */
				.nav-link {
					padding-inline: clamp(0.45rem, 3.4vw - 1.1rem, 0.8rem);
					font-size: clamp(0.8rem, 0.4rem + 0.8vw, 0.875rem);
				}

				.nav-cta {
					padding-inline: 0.9rem;
					font-size: 0.8rem;
				}
			}

			main {
				flex: 1 0 auto;
			}
		</style>
	</body>
</html>
